@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex align-items-center justify-content-center py-5"
     style="min-height: 100vh; background: linear-gradient(135deg, #1e3c72, #6a0dad);">

    <div class="container pb-4">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 col-sm-10">
                <!-- Compact Glassmorphism Card -->
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 20px;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-4">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-2">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-1">Create Account</h3>
                            <p class="text-white-50">Sign up to get started</p>
                        </div>

                        <!-- Register Form -->
                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-4" role="alert"></div>

                            <!-- Username Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.UserName" class="form-label text-white fw-medium mb-1">Username</label>
                                <div class="position-relative">
                                    <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.UserName"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="johndoe"
                                           autocomplete="username"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.UserName" class="text-danger d-block"></span>
                            </div>

                            <!-- Name Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.Name" class="form-label text-white fw-medium mb-1">Full Name</label>
                                <div class="position-relative">
                                    <i class="bi bi-person-badge position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.Name"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="John Doe"
                                           autocomplete="name"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Name" class="text-danger d-block"></span>
                            </div>

                            <!-- Email Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.Email" class="form-label text-white fw-medium mb-1">Email</label>
                                <div class="position-relative">
                                    <i class="bi bi-envelope position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.Email"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="name@example.com"
                                           autocomplete="email"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger d-block"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.Password" class="form-label text-white fw-medium mb-1">Password</label>
                                <div class="position-relative">
                                    <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.Password"
                                           type="password"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Create password"
                                           autocomplete="new-password"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger d-block"></span>
                            </div>

                            <!-- Confirm Password Field -->
                            <div class="mb-4 position-relative">
                                <label asp-for="Input.ConfirmPassword" class="form-label text-white fw-medium mb-1">Confirm Password</label>
                                <div class="position-relative">
                                    <i class="bi bi-lock-fill position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.ConfirmPassword"
                                           type="password"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Confirm password"
                                           autocomplete="new-password"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block"></span>
                            </div>

                            <!-- Register Button -->
                            <button id="registerSubmit"
                                    type="submit"
                                    class="btn w-100 py-2 mb-3 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-person-plus me-2"></i>Create Account
                            </button>

                            <!-- Login Link -->
                            <div class="text-center">
                                <p class="text-white mb-0">
                                    Already have an account?<span>  </span>
                                    <a asp-page="./Login"
                                       asp-route-returnUrl="@Model.ReturnUrl"
                                       class="text-decoration-none fw-medium"
                                       style="color: #7fa3e4">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
                                    </a>
                                </p>
                            </div>

                            <!-- External Login Section (Optional - can be hidden or styled differently) -->
                            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                            {
                                <div class="mt-4 pt-3 border-top border-white-10">
                                    <p class="text-center text-white-50 mb-3">Or sign up with</p>
                                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                        <div class="d-flex justify-content-center gap-2">
                                            @foreach (var provider in Model.ExternalLogins!)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm rounded-pill px-3"
                                                        style="background: rgba(255,255,255,0.1);
                                                                       border: 1px solid rgba(255,255,255,0.2);
                                                                       color: white;"
                                                        name="provider"
                                                        value="@provider.Name"
                                                        title="Register using your @provider.DisplayName account">
                                                    @provider.DisplayName
                                                </button>
                                            }
                                        </div>
                                    </form>
                                </div>
                            }
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Keep it minimal and consistent with login page */
    .form-control:focus {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    body, html {
        margin: 0;
        padding: 0;
        overflow: auto;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }

    /* External login buttons hover effect */
    .btn-sm:hover {
        background: rgba(138, 43, 226, 0.2) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}