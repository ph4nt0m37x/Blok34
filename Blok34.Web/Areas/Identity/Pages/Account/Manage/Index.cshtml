@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="d-flex align-items-start justify-content-start"
     style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-10">
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 2rem;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-3">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-1">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-0">Edit Profile</h3>
                            <p class="text-white-50 mt-1">Update your personal information</p>
                        </div>

                        <!-- Status Message -->
                        <partial name="_StatusMessage" for="StatusMessage" />

                        <!-- Profile Form -->
                        <form id="profile-form" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-3"
                                 role="alert">
                            </div>

                            <!-- Avatar Section -->
                            <div class="text-center mb-3">
                                @if (!string.IsNullOrEmpty(Model.Input.CurrentAvatarPath))
                                {
                                    <!-- Display current avatar -->
                                    <img id="avatarPreview"
                                         src="@Model.Input.CurrentAvatarPath"
                                         alt="Profile Picture"
                                         class="rounded-circle mb-2 border border-white border-opacity-25 shadow"
                                         style="width: 120px; height: 120px; object-fit: cover;" />
                                }
                                else
                                {
                                    <!-- Purple gradient placeholder when no avatar -->
                                    <div id="avatarPlaceholder"
                                         class="rounded-circle mb-2 border border-white border-opacity-25 shadow d-flex align-items-center justify-content-center mx-auto"
                                         style="width: 120px; height: 120px;
                                                    background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                                    cursor: pointer;">
                                        <i class="bi bi-person-fill text-white" style="font-size: 3rem;"></i>
                                    </div>
                                    <!-- Hidden preview image for JavaScript updates -->
                                    <img id="avatarPreview"
                                         src=""
                                         alt="Profile Picture"
                                         class="d-none" />
                                }

                                <!-- Hidden inputs for avatar state -->
                                <input type="hidden" asp-for="Input.AvatarChanged" id="Input_AvatarChanged" />
                                <input type="hidden" asp-for="Input.CurrentAvatarPath" id="Input_CurrentAvatarPath" />
                                <input type="hidden" asp-for="Input.RemoveAvatar" id="Input_RemoveAvatar" />

                                <!-- Avatar Upload -->
                                <div class="mb-3">
                                    <label for="Input_Avatar" class="form-label text-white fw-medium mb-1 d-block text-center">
                                        <i class="bi bi-camera me-1"></i>Change Profile Picture
                                    </label>
                                    <div class="position-relative">
                                        <input asp-for="Input.Avatar"
                                               type="file"
                                               class="form-control bg-transparent text-white rounded-pill"
                                               style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                               accept="image/*"
                                               id="avatarInput"
                                               onchange="previewImage(this)" />
                                        <span asp-validation-for="Input.Avatar" class="text-danger d-block text-center mt-1"></span>
                                        <small class="text-white-50 d-block text-center mt-1">Max size: 2MB</small>
                                    </div>

                                    <!-- Remove Avatar Button (only shown when there's an avatar) -->
                                    @if (!string.IsNullOrEmpty(Model.Input.CurrentAvatarPath))
                                    {
                                        <div class="mt-2">
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                    onclick="removeAvatarImage()"
                                                    style="border-color: #ff6b6b; color: #ff6b6b; font-size: 0.8rem;">
                                                <i class="bi bi-trash me-1"></i>Remove Picture
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Username Field (Disabled) -->
                            <div class="mb-2 position-relative">
                                <label asp-for="Username" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-person me-2"></i>Username
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-tag position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Username"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; background-color: rgba(255,255,255,0.05);"
                                           disabled />
                                </div>
                            </div>

                            <!-- Name Field -->
                            <div class="mb-2 position-relative">
                                <label asp-for="Input.Name" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-person-badge me-2"></i>Full Name
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-card-text position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.Name"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter your full name"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Name" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Bio Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.Bio" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-chat-left-text me-2"></i>Bio
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-pencil position-absolute top-0 start-0 ms-3 mt-3 text-white-50"></i>
                                    <textarea asp-for="Input.Bio"
                                              class="form-control bg-transparent text-white py-2 rounded-4 ps-5"
                                              style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; min-height: 80px;"
                                              placeholder="Tell us about yourself..."
                                              aria-required="false"></textarea>
                                </div>
                                <span asp-validation-for="Input.Bio" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Save Button -->
                            <button id="update-profile-button"
                                    type="submit"
                                    class="btn w-100 py-2 mb-2 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-save me-2"></i>Save Changes
                            </button>

                            <!-- Back to Dashboard Link -->
                            <div class="text-center mt-3">
                                <a href="/"
                                   class="text-decoration-none fw-medium"
                                   style="color: #7fa3e4">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Consistent with registration page styling */
    .form-control:focus,
    .form-control:focus-within {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    .form-control:disabled {
        background-color: rgba(255,255,255,0.05) !important;
        color: rgba(255,255,255,0.6) !important;
    }

    textarea.form-control {
        resize: vertical;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }

    /* File input styling */
    input[type="file"]::-webkit-file-upload-button {
        background: rgba(138, 43, 226, 0.2);
        border: 1px solid rgba(138, 43, 226, 0.5);
        color: white;
        padding: 0.25rem 1rem;
        border-radius: 20px;
        margin-right: 1rem;
        transition: all 0.2s ease;
    }

        input[type="file"]::-webkit-file-upload-button:hover {
            background: rgba(138, 43, 226, 0.3);
        }

    /* Ensure proper spacing */
    body, html {
        margin: 0;
        padding: 0;
        overflow: auto;
    }

    /* Button hover effect */
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(106,13,173,0.4) !important;
    }

    /* Placeholder hover effect */
    #avatarPlaceholder:hover {
        transform: scale(1.05);
        transition: transform 0.2s ease;
        box-shadow: 0 0 20px rgba(138, 43, 226, 0.5) !important;
    }

    /* Remove button hover effect */
    .btn-outline-danger:hover {
        background-color: rgba(255, 107, 107, 0.1) !important;
        border-color: #ff6b6b !important;
        color: #ff6b6b !important;
        transform: translateY(-1px);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Function to remove avatar
        function removeAvatarImage() {
            if (confirm('Are you sure you want to remove your profile picture?')) {
                const preview = document.getElementById('avatarPreview');
                const placeholder = document.getElementById('avatarPlaceholder');
                const fileInput = document.getElementById('avatarInput');
                const removeAvatarInput = document.getElementById('Input_RemoveAvatar');

                // Clear file input
                if (fileInput) {
                    fileInput.value = '';
                }

                // Set remove flag to true
                removeAvatarInput.value = 'true';

                // Hide preview and show placeholder
                if (preview) {
                    preview.classList.add('d-none');
                }

                if (!placeholder) {
                    // Create placeholder if it doesn't exist
                    const avatarSection = document.querySelector('.text-center.mb-3');
                    const newPlaceholder = document.createElement('div');
                    newPlaceholder.id = 'avatarPlaceholder';
                    newPlaceholder.className = 'rounded-circle mb-2 border border-white border-opacity-25 shadow d-flex align-items-center justify-content-center mx-auto';
                    newPlaceholder.style.cssText = 'width: 120px; height: 120px; background: linear-gradient(135deg, #6a0dad, #8a2be2); cursor: pointer;';
                    newPlaceholder.innerHTML = '<i class="bi bi-person-fill text-white" style="font-size: 3rem;"></i>';

                    // Insert placeholder before the hidden inputs
                    const hiddenInputs = avatarSection.querySelector('input[type="hidden"]');
                    avatarSection.insertBefore(newPlaceholder, hiddenInputs);

                    // Make new placeholder clickable
                    newPlaceholder.addEventListener('click', function() {
                        fileInput.click();
                    });
                } else {
                    placeholder.classList.remove('d-none');
                    placeholder.style.display = 'flex';
                }

                // Set avatar changed flag
                document.getElementById('Input_AvatarChanged').value = 'true';

                // Hide remove button
                const removeButton = document.querySelector('button[onclick="removeAvatarImage()"]');
                if (removeButton) {
                    removeButton.style.display = 'none';
                }

                // Show confirmation message
                alert('Profile picture will be removed when you click "Save Changes"');
            }
        }

        // Preview image before uploading
        function previewImage(input) {
            const preview = document.getElementById('avatarPreview');
            const placeholder = document.getElementById('avatarPlaceholder');
            const file = input.files[0];
            const avatarChangedInput = document.getElementById('Input_AvatarChanged');
            const removeAvatarInput = document.getElementById('Input_RemoveAvatar');

            // Reset remove flag when new image is selected
            removeAvatarInput.value = 'false';

            // Show remove button if it exists
            const removeButton = document.querySelector('button[onclick="removeAvatarImage()"]');
            if (removeButton) {
                removeButton.style.display = 'block';
            }

            if (file) {
                // Check file size (max 2MB)
                if (file.size > 2 * 1024 * 1024) {
                    alert('File size must be less than 2MB');
                    input.value = '';
                    return;
                }

                // Check file type
                if (!file.type.match('image.*')) {
                    alert('Please select an image file');
                    input.value = '';
                    return;
                }

                const reader = new FileReader();

                reader.onload = function(e) {
                    // If placeholder exists, hide it and show preview
                    if (placeholder) {
                        placeholder.classList.add('d-none');
                        placeholder.style.display = 'none';
                    }

                    // Show preview image
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    preview.classList.add('rounded-circle', 'mb-2', 'border', 'border-white', 'border-opacity-25', 'shadow');
                    preview.style.width = '120px';
                    preview.style.height = '120px';
                    preview.style.objectFit = 'cover';

                    avatarChangedInput.value = 'true';

                    // Add a visual indicator that image has changed
                    preview.style.border = '2px solid #8a2be2';
                    preview.style.boxShadow = '0 0 15px rgba(138, 43, 226, 0.5)';

                    // Remove indicator after 2 seconds
                    setTimeout(() => {
                        preview.style.border = '1px solid rgba(255,255,255,0.25)';
                        preview.style.boxShadow = 'none';
                    }, 2000);
                }

                reader.readAsDataURL(file);
            } else {
                // If no file selected, revert to placeholder or current avatar
                const currentPath = document.getElementById('Input_CurrentAvatarPath').value;

                if (currentPath && currentPath.trim() !== '' && removeAvatarInput.value !== 'true') {
                    // If there's a current avatar path and we're not removing it, show it
                    preview.src = currentPath;
                    if (placeholder) {
                        placeholder.classList.add('d-none');
                        placeholder.style.display = 'none';
                    }
                    preview.classList.remove('d-none');
                } else {
                    // If no avatar or we're removing it, show placeholder
                    if (placeholder) {
                        placeholder.classList.remove('d-none');
                        placeholder.style.display = 'flex';
                    }
                    preview.classList.add('d-none');
                }
                avatarChangedInput.value = 'false';
            }
        }

        // Make placeholder clickable to trigger file input
        document.addEventListener('DOMContentLoaded', function() {
            const placeholder = document.getElementById('avatarPlaceholder');
            const fileInput = document.getElementById('avatarInput');

            if (placeholder && fileInput) {
                placeholder.addEventListener('click', function() {
                    fileInput.click();
                });
            }
        });

        // Show loading indicator on form submit
        document.getElementById('profile-form').addEventListener('submit', function() {
            const submitButton = document.getElementById('update-profile-button');
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
            submitButton.disabled = true;
        });
    </script>
}