@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="d-flex align-items-start justify-content-start"
     style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-10">
                <!-- Glassmorphism Card -->
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 2rem;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-3">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-1">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-0">Change Password</h3>
                            <p class="text-white-50 mt-1">Update your account password</p>
                        </div>

                        <!-- Status Message -->
                        <partial name="_StatusMessage" for="StatusMessage" />

                        <!-- Password Change Form -->
                        <form id="change-password-form" method="post">
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-3"
                                 role="alert">
                            </div>

                            <!-- Current Password -->
                            <div class="mb-2 position-relative">
                                <label asp-for="Input.OldPassword" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-key me-2"></i>Current Password
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.OldPassword"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter your current password"
                                           autocomplete="current-password"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.OldPassword" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- New Password -->
                            <div class="mb-2 position-relative">
                                <label asp-for="Input.NewPassword" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-key-fill me-2"></i>New Password
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-lock-fill position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.NewPassword"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter new password"
                                           autocomplete="new-password"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.NewPassword" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Confirm New Password -->
                            <div class="mb-4 position-relative">
                                <label asp-for="Input.ConfirmPassword" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-shield-check me-2"></i>Confirm New Password
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-shield-check position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.ConfirmPassword"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Confirm new password"
                                           autocomplete="new-password"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Update Password Button -->
                            <button type="submit"
                                    class="btn w-100 py-2 mb-2 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-arrow-repeat me-2"></i>Update Password
                            </button>

                            <!-- Back to Profile Link -->
                            <div class="text-center mt-3">
                                <a asp-page="./Index"
                                   class="text-decoration-none fw-medium"
                                   style="color: #7fa3e4">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Profile
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Consistent with other pages styling */
    .form-control:focus,
    .form-control:focus-within {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    /* Password field specific styling */
    input[type="password"] {
        letter-spacing: 0.1em;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }

    /* Button hover effects */
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(106,13,173,0.4) !important;
    }

    /* Password strength indicator (optional) */
    .password-strength {
        height: 4px;
        border-radius: 2px;
        margin-top: 0.25rem;
        background: rgba(255,255,255,0.1);
        overflow: hidden;
    }

    .password-strength-bar {
        height: 100%;
        transition: width 0.3s ease;
        background: linear-gradient(90deg, #dc3545, #ffc107, #198754);
    }
</style>

<script>
    // Optional: Add password strength indicator
    document.addEventListener('DOMContentLoaded', function() {
        const newPasswordInput = document.getElementById('Input_NewPassword');
        const confirmPasswordInput = document.getElementById('Input_ConfirmPassword');

        if (newPasswordInput) {
            // Create password strength indicator
            const strengthContainer = document.createElement('div');
            strengthContainer.className = 'password-strength mt-1';
            const strengthBar = document.createElement('div');
            strengthBar.className = 'password-strength-bar';
            strengthContainer.appendChild(strengthBar);
            newPasswordInput.parentNode.appendChild(strengthContainer);

            newPasswordInput.addEventListener('input', function() {
                const password = this.value;
                let strength = 0;

                // Check password strength
                if (password.length >= 8) strength += 25;
                if (/[A-Z]/.test(password)) strength += 25;
                if (/[0-9]/.test(password)) strength += 25;
                if (/[^A-Za-z0-9]/.test(password)) strength += 25;

                strengthBar.style.width = strength + '%';

                // Update color based on strength
                if (strength < 50) {
                    strengthBar.style.background = '#dc3545';
                } else if (strength < 75) {
                    strengthBar.style.background = '#ffc107';
                } else {
                    strengthBar.style.background = '#198754';
                }
            });

            // Confirm password validation
            if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', function() {
                    if (newPasswordInput.value !== this.value && this.value.length > 0) {
                        this.style.borderColor = 'rgba(220, 53, 69, 0.5)';
                    } else {
                        this.style.borderColor = 'rgba(255,255,255,0.3)';
                    }
                });
            }
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}