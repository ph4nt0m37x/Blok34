@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="d-flex align-items-start justify-content-start"
     style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-10">
                <!-- Glassmorphism Card -->
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 2rem;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-3">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-1">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-0">Email Settings</h3>
                            <p class="text-white-50 mt-1">Manage your email address</p>
                        </div>

                        <!-- Status Message -->
                        <partial name="_StatusMessage" for="StatusMessage" />

                        <!-- Email Form -->
                        <form id="email-form" method="post">
                            @* <div asp-validation-summary="All"
                                 class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-3"
                                 role="alert">
                            </div> *@

                            <!-- Current Email -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Email" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-envelope-at me-2"></i>Current Email
                                </label>
                                <div class="position-relative">
                                    @if (Model.IsEmailConfirmed)
                                    {
                                        <div class="input-group">
                                            <i class="bi bi-envelope-check position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                            <input asp-for="Email"
                                                   class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                                   style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; background-color: rgba(255,255,255,0.05);"
                                                   disabled />
                                            <div class="input-group-append">
                                                <span class="input-group-text bg-success bg-opacity-25 border-success border-opacity-25 text-success fw-bold h-100 rounded-end-pill">
                                                    <i class="bi bi-check-circle me-1"></i>Verified
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="position-relative">
                                            <i class="bi bi-envelope position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                            <input asp-for="Email"
                                                   class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                                   style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; background-color: rgba(255,255,255,0.05);"
                                                   disabled />
                                        </div>
                                        <div class="text-center mt-2">
                                            <button id="email-verification"
                                                    type="submit"
                                                    asp-page-handler="SendVerificationEmail"
                                                    class="btn btn-sm rounded-pill px-3"
                                                    style="background: rgba(138, 43, 226, 0.2);
                                                               border: 1px solid rgba(138, 43, 226, 0.4);
                                                               color: white;
                                                               font-size: 0.8rem;" disabled>
                                                <i class="bi bi-send me-1"></i>Send Verification Email
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- New Email Input -->
                            <div class="mb-4 position-relative">
                                <label asp-for="Input.NewEmail" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-envelope-plus me-2"></i>New Email Address
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-envelope-plus position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.NewEmail"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter new email address"
                                           autocomplete="email"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.NewEmail" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Change Email Button -->
                            <button id="change-email-button"
                                    type="submit"
                                    asp-page-handler="ChangeEmail"
                                    class="btn w-100 py-2 mb-2 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-envelope-arrow-up me-2"></i>Change Email
                            </button>

                            <!-- Back to Profile Link -->
                            <div class="text-center mt-3">
                                <a asp-page="./Index"
                                   class="text-decoration-none fw-medium"
                                   style="color: #7fa3e4">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Profile
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Consistent with other pages styling */
    .form-control:focus,
    .form-control:focus-within {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    .form-control:disabled {
        background-color: rgba(255,255,255,0.05) !important;
        color: rgba(255,255,255,0.6) !important;
    }

    /* Input group styling */
    .input-group .form-control {
        border-top-right-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        border-right: none;
    }

    .input-group-append .input-group-text {
        border-top-left-radius: 0 !important;
        border-bottom-left-radius: 0 !important;
        border-left: none;
        background: rgba(25, 135, 84, 0.2);
        border-color: rgba(25, 135, 84, 0.4);
        color: #75b798;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }

    /* Button hover effects */
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(106,13,173,0.4) !important;
    }

    .btn-sm:hover {
        background: rgba(138, 43, 226, 0.3) !important;
        border-color: rgba(138, 43, 226, 0.6) !important;
        transform: translateY(-1px);
    }

    /* Verification button styling */
    #email-verification {
        transition: all 0.2s ease;
    }

    /* Input group focus states */
    .input-group:focus-within .form-control {
        z-index: 3;
    }

    .input-group:focus-within .input-group-text {
        z-index: 3;
        background: rgba(25, 135, 84, 0.3);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}