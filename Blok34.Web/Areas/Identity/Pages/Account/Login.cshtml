@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="d-flex align-items-center justify-content-center"
     style="min-height: 100vh; background: linear-gradient(135deg, #1e3c72, #6a0dad);">

    <div class="container pb-4">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 col-sm-10">
                <!-- Compact Glassmorphism Card -->
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 20px;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-4">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-2">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-1">Welcome Back</h3>
                            <p class="text-white-50">Sign in to continue</p>
                        </div>

                        <!-- Login Form -->
                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-4" role="alert"></div>

                            <!-- Username Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.UserName" class="form-label text-white fw-medium mb-1">Username</label>
                                <div class="position-relative">
                                    <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.UserName"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter username"
                                           autocomplete="username"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.UserName" class="text-danger  d-block"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Input.Password" class="form-label text-white fw-medium mb-1">Password</label>
                                <div class="position-relative">
                                    <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Input.Password"
                                           type="password"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter password"
                                           autocomplete="current-password"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger  d-block"></span>
                            </div>

                            <!-- Remember Me & Forgot Password -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input rounded-circle"
                                           type="checkbox"
                                           asp-for="Input.RememberMe"
                                           style="width: 16px; height: 16px;
                                                  background-color: transparent;
                                                  border-color: rgba(255,255,255,0.5);" />
                                    <label class="form-check-label text-white" asp-for="Input.RememberMe">
                                        Remember me
                                    </label>
                                </div>
                                <a id="forgot-password"
                                   asp-page="./ForgotPassword"
                                   class="text-decoration-none"
                                   style="color: #7fa3e4">
                                    <i class="bi bi-key me-1"></i>Forgot password?
                                </a>
                            </div>

                            <!-- Login Button -->
                            <button id="login-submit"
                                    type="submit"
                                    class="btn w-100 py-2 mb-3 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                            </button>

                            <!-- Register Link -->
                            <div class="text-center">
                                <p class="text-white mb-0">
                                    Don't have an account?<span>  </span>
                                    <a asp-page="./Register"
                                       asp-route-returnUrl="@Model.ReturnUrl"
                                       class="text-decoration-none fw-medium"
                                       style="color: #7fa3e4">
                                        <i class="bi bi-person-plus me-1"></i>Sign up
                                    </a>
                                </p>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Keep it minimal */
    .form-control:focus {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    body, html {
        margin: 0;
        padding: 0;
        overflow: auto;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}