@using System.Security.Claims
@model IEnumerable<Blok34.Domain.DomainModels.Event>

@{
    ViewData["Title"] = "Events";
    var now = DateTime.UtcNow;
    var upcomingEvents = Model.Where(e => e.StartDate > now).OrderBy(e => e.StartDate);
    var ongoingEvents = Model.Where(e => e.StartDate <= now && (!e.EndDate.HasValue || e.EndDate.Value >= now));
    var pastEvents = Model.Where(e => e.EndDate.HasValue && e.EndDate.Value < now);

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="events-page" style="min-height: 100vh; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 25%, #6a0dad 75%, #8a2be2 100%);">

    <!-- Hero Section -->
    <div class="hero-section" style="padding-top: 100px; padding-bottom: 60px;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="display-4 fw-bold text-white mb-4">
                        <i class="bi bi-calendar-event me-3"></i>Discover Amazing <span class="gradient-text">Events</span>
                    </h1>
                    <p class="lead text-white-50 mb-5" style="line-height: 1.8;">
                        Find your next adventure, connect with like-minded people, and create memories
                        that last a lifetime. From intimate gatherings to large-scale celebrations.
                    </p>

                    <!-- Event Stats -->
                    <div class="d-flex justify-content-center gap-5 mb-5">
                        <div class="text-center">
                            <div class="text-white fw-bold fs-3">@upcomingEvents.Count()</div>
                            <div class="text-white-50 small">Upcoming</div>
                        </div>
                        <div class="text-center">
                            <div class="text-white fw-bold fs-3">@ongoingEvents.Count()</div>
                            <div class="text-white-50 small">Ongoing</div>
                        </div>
                        <div class="text-center">
                            <div class="text-white fw-bold fs-3">@Model.Count()</div>
                            <div class="text-white-50 small">Total</div>
                        </div>
                    </div>

                    <!-- CTA Buttons -->
                    <div class="d-flex justify-content-center flex-wrap gap-3">
                        <a asp-action="Create"
                           class="btn rounded-pill px-5 py-3 fw-bold btn-glow"
                           style="background: linear-gradient(135deg, #8a2be2, #5D3FD3); color: white; border: none;">
                            <i class="bi bi-plus-circle me-2"></i>Create New Event
                        </a>
                        <a asp-controller="Venues" asp-action="Index"
                           class="btn rounded-pill px-5 py-3 fw-bold"
                           style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: white;">
                            <i class="bi bi-building me-2"></i>Browse Venues
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="container mb-5">
        <div class="card border-0 shadow-lg"
             style="background: rgba(255,255,255,0.07); backdrop-filter: blur(12px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15);">
            <div class="card-body p-4">
                <div class="row g-4">
                    <!-- Search -->
                    <div class="col-md-6">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-transparent border-end-0"
                                  style="border-color: rgba(255,255,255,0.3); color: white;">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control bg-transparent text-white border-start-0"
                                   placeholder="Search events by title, description, or venue..."
                                   style="border-color: rgba(255,255,255,0.3);"
                                   id="eventSearch">
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="col-md-6">
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn rounded-pill px-4 py-2 filter-btn active"
                                    data-filter="all">
                                All Events
                            </button>
                            <button class="btn rounded-pill px-4 py-2 filter-btn"
                                    data-filter="upcoming">
                                <i class="bi bi-calendar-check me-1"></i>Upcoming
                            </button>
                            <button class="btn rounded-pill px-4 py-2 filter-btn"
                                    data-filter="ongoing">
                                <i class="bi bi-play-circle me-1"></i>Ongoing
                            </button>
                            <button class="btn rounded-pill px-4 py-2 filter-btn"
                                    data-filter="past">
                                <i class="bi bi-clock-history me-1"></i>Past
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Tabs -->
    <div class="container pb-5">
        <div class="row g-4" id="eventsContainer">
            @if (Model.Any())
            {
                @foreach (var ev in Model.OrderByDescending(e => e.StartDate))
                {
                    var isPast = ev.EndDate.HasValue ? ev.EndDate.Value < now : ev.StartDate < now;
                    var isUpcoming = ev.StartDate > now;
                    var isOngoing = ev.StartDate <= now && (!ev.EndDate.HasValue || ev.EndDate.Value >= now);
                    var attendingCount = ev.Attendees?.Count ?? 0;

                    // Check if we should show creator info
                    var showCreatorInfo = ev.Venue == null || ev.Venue.IsPublic;

                    <div class="col-12 event-card-wrapper"
                         data-status="@(isPast ? "past" : isOngoing ? "ongoing" : "upcoming")">
                        <div class="card border-0 shadow-lg event-card"
                             style="background: rgba(255,255,255,0.07); backdrop-filter: blur(12px); border-radius: 15px; border: 1px solid rgba(255,255,255,0.15); overflow: hidden;">
                            <div class="row g-0">
                                <!-- Event Image Column -->
                                <div class="col-md-4">
                                    <div class="position-relative h-100">
                                        @if (ev.Venue != null && !string.IsNullOrEmpty(ev.Venue.BannerPath))
                                        {
                                            <img src="@ev.Venue.BannerPath"
                                                 class="img-fluid h-100 w-100"
                                                 alt="@ev.Title"
                                                 style="object-fit: cover; min-height: 200px;">
                                        }
                                        else
                                        {
                                            <div class="h-100 d-flex align-items-center justify-content-center"
                                                 style="background: linear-gradient(135deg, #8a2be2, #5D3FD3); min-height: 200px;">
                                                <i class="bi bi-calendar-event text-white" style="font-size: 3rem;"></i>
                                            </div>
                                        }

                                        <!-- Event Status Badge -->
                                        <div class="position-absolute top-0 end-0 mt-3 me-3">
                                            @if (isPast)
                                            {
                                                <span class="badge rounded-pill px-3 py-2"
                                                      style="background: rgba(108, 117, 125, 0.3); border: 1px solid rgba(108, 117, 125, 0.5); color: white;">
                                                    <i class="bi bi-clock-history me-1"></i>Past
                                                </span>
                                            }
                                            else if (isOngoing)
                                            {
                                                <span class="badge rounded-pill px-3 py-2"
                                                      style="background: rgba(25, 135, 84, 0.3); border: 1px solid rgba(25, 135, 84, 0.5); color: white;">
                                                    <i class="bi bi-play-circle me-1"></i>Ongoing
                                                </span>
                                            }
                                            else if (isUpcoming)
                                            {
                                                <span class="badge rounded-pill px-3 py-2"
                                                      style="background: rgba(13, 110, 253, 0.3); border: 1px solid rgba(13, 110, 253, 0.5); color: white;">
                                                    <i class="bi bi-calendar-check me-1"></i>Upcoming
                                                </span>
                                            }
                                        </div>

                                        <!-- Date Badge -->
                                        <div class="position-absolute bottom-0 start-0 m-3">
                                            <div class="text-center p-2 rounded"
                                                 style="background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); min-width: 70px;">
                                                <div class="text-white fw-bold fs-5">@ev.StartDate.ToString("dd")</div>
                                                <div class="text-white-50 small">@ev.StartDate.ToString("MMM")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Event Details Column -->
                                <div class="col-md-8">
                                    <div class="card-body p-4 h-100 d-flex flex-column">
                                        <div class="flex-grow-1">
                                            <!-- Event Header -->
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <h3 class="card-title text-white fw-bold mb-0">@ev.Title</h3>
                                                <div class="text-end">
                                                    <div class="text-white fw-bold">@ev.StartDate.ToString("hh:mm tt")</div>
                                                    @if (ev.EndDate.HasValue)
                                                    {
                                                        <div class="text-white-50 small">Ends @ev.EndDate.Value.ToString("hh:mm tt")</div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Event Description -->
                                            @if (!string.IsNullOrEmpty(ev.Description))
                                            {
                                                <p class="text-white-50 mb-4" style="line-height: 1.6; font-size: 0.95rem;">
                                                    @(ev.Description.Length > 200 ? ev.Description.Substring(0, 200) + "..." : ev.Description)
                                                </p>
                                            }

                                            <!-- Event Details Grid -->
                                            <div class="row g-3 mb-4">
                                                @if (ev.Venue != null)
                                                {
                                                    <div class="col-md-6">
                                                        <div class="d-flex align-items-center">
                                                            <div class="me-3" style="width: 32px; height: 32px; background: rgba(138, 43, 226, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                                <i class="bi bi-geo-alt text-white"></i>
                                                            </div>
                                                            <div>
                                                                <div class="text-white-50 small">Venue</div>
                                                                <div class="text-white fw-medium">@ev.Venue.Name</div>
                                                                @if (!string.IsNullOrEmpty(ev.Venue.Address))
                                                                {
                                                                    <div class="text-white-50 small" style="font-size: 0.85rem;">
                                                                        @ev.Venue.Address
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                <div class="col-md-6">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3" style="width: 32px; height: 32px; background: rgba(13, 110, 253, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi bi-people text-white"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-white-50 small">Attending</div>
                                                            <div class="text-white fw-medium">@attendingCount people</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (showCreatorInfo && !string.IsNullOrEmpty(ev.CreatedByUserId))
                                                {
                                                    <div class="col-md-6">
                                                        <div class="d-flex align-items-center">
                                                            <div class="me-3" style="width: 32px; height: 32px; background: rgba(255, 193, 7, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                                <i class="bi bi-person-circle text-white"></i>
                                                            </div>
                                                            <div>
                                                                <div class="text-white-50 small">Organizer</div>
                                                                <div class="text-white fw-medium">User @ev.CreatedByUserId</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                <div class="col-md-6">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3" style="width: 32px; height: 32px; background: rgba(25, 135, 84, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                            <i class="bi bi-tag text-white"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-white-50 small">Category</div>
                                                            <div class="text-white fw-medium">@Html.DisplayFor(modelItem => ev.Category)</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="mt-auto pt-3 border-top border-white-10">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <a asp-action="Details" asp-route-id="@ev.Id"
                                                   class="btn rounded-pill px-4 py-2 fw-bold"
                                                   style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: white;">
                                                    <i class="bi bi-eye me-2"></i>View Details
                                                </a>

                                                <!-- Join/Attend Button (if applicable) -->
                                                @if (isUpcoming && !string.IsNullOrEmpty(userId))
                                                {
                                                    <button class="btn rounded-pill px-4 py-2 fw-bold btn-join"
                                                            data-event-id="@ev.Id"
                                                            style="background: rgba(25, 135, 84, 0.2); border: 1px solid rgba(25, 135, 84, 0.4); color: white;">
                                                        <i class="bi bi-calendar-plus me-2"></i>Join Event
                                                    </button>
                                                }
                                                else if (isOngoing)
                                                {
                                                    <span class="badge rounded-pill px-3 py-2"
                                                          style="background: rgba(255, 193, 7, 0.2); border: 1px solid rgba(255, 193, 7, 0.4); color: white;">
                                                        <i class="bi bi-play-circle me-1"></i>Live Now
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="col-12">
                    <div class="text-center py-5">
                        <div class="card border-0 shadow-lg mx-auto"
                             style="max-width: 600px; background: rgba(255,255,255,0.05); backdrop-filter: blur(10px);">
                            <div class="card-body py-5">
                                <i class="bi bi-calendar-x display-1 text-white-50 mb-4"></i>
                                <h4 class="text-white mb-3">No Events Yet</h4>
                                <p class="text-white-50 mb-4">Be the first to create an amazing event!</p>
                                <a asp-action="Create"
                                   class="btn rounded-pill px-4 py-2 fw-bold"
                                   style="background: linear-gradient(135deg, #6a0dad, #8a2be2); color: white;">
                                    <i class="bi bi-plus-circle me-2"></i>Create Your First Event
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination (if needed) -->
        @if (Model.Count() > 10)
        {
            <div class="mt-5">
                <nav aria-label="Event pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item">
                            <a class="page-link bg-transparent text-white border-white-10" href="#" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        <li class="page-item active">
                            <a class="page-link" href="#"
                               style="background: linear-gradient(135deg, #8a2be2, #5D3FD3); border: none;">1</a>
                        </li>
                        <li class="page-item"><a class="page-link bg-transparent text-white border-white-10" href="#">2</a></li>
                        <li class="page-item"><a class="page-link bg-transparent text-white border-white-10" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link bg-transparent text-white border-white-10" href="#" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    /* Reuse styles from previous pages */
    .gradient-text {
        background: linear-gradient(135deg, #8a2be2, #5D3FD3);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .event-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .event-card:hover {
            transform: translateY(-8px) scale(1.005);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4) !important;
            border-color: rgba(138, 43, 226, 0.4) !important;
        }

    .btn-glow:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(138, 43, 226, 0.4);
        transition: all 0.2s ease;
    }

    .border-white-10 {
        border-color: rgba(255,255,255,0.1) !important;
    }

    /* Filter button styles */
    .filter-btn {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        transition: all 0.3s ease;
    }

        .filter-btn:hover,
        .filter-btn.active {
            background: linear-gradient(135deg, #8a2be2, #5D3FD3);
            border-color: rgba(138, 43, 226, 0.5);
            transform: translateY(-2px);
        }

    /* Form styling */
    .form-control:focus {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
    }

    /* Pagination styling */
    .page-link {
        margin: 0 5px;
        border-radius: 10px !important;
        transition: all 0.3s ease;
    }

        .page-link:hover {
            background: rgba(138, 43, 226, 0.2) !important;
            border-color: rgba(138, 43, 226, 0.3) !important;
        }

    /* Join button animation */
    .btn-join {
        transition: all 0.3s ease;
    }

        .btn-join:hover {
            background: rgba(25, 135, 84, 0.4) !important;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(25, 135, 84, 0.3);
        }

    /* Date badge styling */
    .position-absolute .rounded {
        transition: transform 0.3s ease;
    }

    .event-card:hover .position-absolute .rounded {
        transform: scale(1.1);
    }

</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Filter functionality
        const filterBtns = document.querySelectorAll('.filter-btn');
        const eventCards = document.querySelectorAll('.event-card-wrapper');
        const eventSearch = document.getElementById('eventSearch');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                // Remove active class from all buttons
                filterBtns.forEach(b => b.classList.remove('active'));
                // Add active class to clicked button
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');

                // Filter event cards
                eventCards.forEach(card => {
                    const status = card.getAttribute('data-status');

                    if (filter === 'all' || filter === status) {
                        card.style.display = 'block';
                        setTimeout(() => {
                            card.style.opacity = '1';
                            card.style.transform = 'translateY(0)';
                        }, 10);
                    } else {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            card.style.display = 'none';
                        }, 300);
                    }
                });
            });
        });

        // Search functionality
        if (eventSearch) {
            eventSearch.addEventListener('input', function(e) {
                const searchTerm = e.target.value.toLowerCase();

                eventCards.forEach(card => {
                    const title = card.querySelector('.card-title').textContent.toLowerCase();
                    const description = card.querySelector('p.text-white-50')?.textContent.toLowerCase() || '';
                    const venue = card.querySelector('.text-white.fw-medium')?.textContent.toLowerCase() || '';

                    if (title.includes(searchTerm) || description.includes(searchTerm) || venue.includes(searchTerm)) {
                        card.style.display = 'block';
                        setTimeout(() => {
                            card.style.opacity = '1';
                            card.style.transform = 'translateY(0)';
                        }, 10);
                    } else {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            card.style.display = 'none';
                        }, 300);
                    }
                });
            });
        }

        // Join event button functionality
        const joinBtns = document.querySelectorAll('.btn-join');
        joinBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const eventId = this.getAttribute('data-event-id');
                const originalText = this.innerHTML;
                const originalBg = this.style.background;

                // Show loading state
                this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Joining...';
                this.style.background = 'rgba(255, 193, 7, 0.3)';
                this.disabled = true;

                // Simulate API call
                setTimeout(() => {
                    // Success state
                    this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Joined!';
                    this.style.background = 'rgba(25, 135, 84, 0.4)';

                    // Revert after 2 seconds
                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.style.background = originalBg;
                        this.disabled = false;
                    }, 2000);
                }, 1000);
            });
        });

        // Add animation to event cards on load
        eventCards.forEach((card, index) => {
            card.style.animationDelay = `${index * 0.1}s`;
            card.style.opacity = '1';
        });

        // Add hover effects
        eventCards.forEach(card => {
            const eventCard = card.querySelector('.event-card');

            eventCard.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-8px) scale(1.005)';
                this.style.boxShadow = '0 20px 40px rgba(0,0,0,0.4)';
                this.style.borderColor = 'rgba(138, 43, 226, 0.4)';
            });

            eventCard.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
                this.style.boxShadow = '0 0 15px rgba(0,0,0,0.1)';
                this.style.borderColor = 'rgba(255,255,255,0.15)';
            });
        });

        // Initialize tooltips
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            const tooltips = document.querySelectorAll('[title]');
            tooltips.forEach(element => {
                new bootstrap.Tooltip(element);
            });
        }
    });
</script>