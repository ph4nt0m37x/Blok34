@model Blok34.Domain.DomainModels.Event
@Html.AntiForgeryToken()
@using Blok34.Domain.Enums
@using Blok34.Domain.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Delete Event";
    var isPublicVenue = Model.Venue?.IsPublic ?? false;
    var hasBanner = !string.IsNullOrEmpty(Model.Venue?.BannerPath);
    var bannerUrl = hasBanner ? Model.Venue.BannerPath : "/images/default-event-banner.jpg";

    var currentUserId = UserManager.GetUserId(User);
    var isCreator = Model.CreatedByUserId == currentUserId;

    // Event status calculation
    var now = DateTime.UtcNow;
    var status = "Upcoming";
    var statusColor = "success";
    var statusIcon = "bi-calendar-event";

    if (Model.StartDate <= now && (!Model.EndDate.HasValue || Model.EndDate.Value > now))
    {
        status = "Ongoing";
        statusColor = "info";
        statusIcon = "bi-play-circle";
    }
    else if (Model.EndDate.HasValue && Model.EndDate.Value <= now)
    {
        status = "Completed";
        statusColor = "secondary";
        statusIcon = "bi-check-circle";
    }
}

<div class="d-flex align-items-start justify-content-start" style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12">
                <!-- Event Banner with Warning Overlay -->
                @if (hasBanner)
                {
                    <div class="card border-0 shadow mb-4" style="border-radius: 20px; overflow: hidden; border: 1px solid rgba(220,53,69,0.3);">
                        <div class="position-relative" style="height: 300px;">
                            <img src="@bannerUrl" class="card-img-top" alt="@Model.Venue.Name Banner" style="height: 100%; width: 100%; object-fit: cover; opacity: 0.7;">
                            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(220,53,69,0.4), rgba(108,117,125,0.8));"></div>
                            <div class="position-absolute bottom-0 start-0 p-4">
                                <span class="badge rounded-pill px-3 py-2 mb-2" style="background: rgba(220,53,69,0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.2);">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Deleting Event
                                </span>
                                <h1 class="text-white fw-bold mb-0" style="text-shadow: 0 2px 10px rgba(0,0,0,0.7);">@Model.Title</h1>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow mb-4" style="background: linear-gradient(135deg, #dc3545, #6c757d); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15);">
                        <div class="card-body p-5 text-center">
                            <svg width="80" height="60" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-3">
                                <defs>
                                    <linearGradient id="gradDelete" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#ffffff" />
                                        <stop offset="100%" stop-color="#f8d7da" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#gradDelete)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#ffffff" opacity="0.9" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#f8d7da" opacity="0.9" />
                                <path d="M85,15 L95,25 M95,15 L85,25" stroke="#dc3545" stroke-width="3" stroke-linecap="round" />
                            </svg>
                            <h1 class="text-white fw-bold mb-2">@Model.Title</h1>
                            <span class="badge rounded-pill px-3 py-2" style="background: rgba(220,53,69,0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3);">
                                <i class="bi bi-exclamation-triangle me-1"></i>Delete Event
                            </span>
                        </div>
                    </div>
                }

                <!-- Warning Card -->
                <div class="card border-0 shadow mb-4" style="background: rgba(220,53,69,0.1); backdrop-filter: blur(12px); border-radius: 20px; border: 1px solid rgba(220,53,69,0.3);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: rgba(220,53,69,0.2); border: 2px solid rgba(220,53,69,0.4);">
                                    <i class="bi bi-exclamation-octagon text-danger" style="font-size: 1.8rem;"></i>
                                </div>
                            </div>
                            <div>
                                <h4 class="text-white fw-bold mb-1"><i class="bi bi-shield-exclamation me-2"></i>Warning: Permanent Action</h4>
                                <p class="text-white-50 mb-0">This action cannot be undone. All event data including attendee information will be permanently deleted.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Card -->
                <div class="card border-0 shadow" style="background: rgba(255,255,255,0.07); backdrop-filter: blur(12px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15); margin-bottom: 2rem;">
                    <div class="card-body p-4 p-md-5">
                        <div class="row">
                            <!-- Left Column - Event Details -->
                            <div class="col-lg-8">
                                <!-- Event Information -->
                                <div class="mb-5">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Event Information</h4>
                                    <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                        <div class="row mb-3">
                                            <div class="col-md-6 mb-2">
                                                <div class="text-white-50 small">Event Title</div>
                                                <div class="text-white fw-medium">@Model.Title</div>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <div class="text-white-50 small">Category</div>
                                                <div class="text-white fw-medium">@Model.Category</div>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <div class="text-white-50 small">Status</div>
                                                <div><span class="badge bg-@statusColor"><i class="bi @statusIcon me-1"></i>@status</span></div>
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <div class="text-white-50 small">Venue Type</div>
                                                <div class="text-white">@(Model.Venue?.IsPublic == true ? "Public" : "Private")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Event Description -->
                                <div class="mb-5">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-text-paragraph me-2"></i>Description</h4>
                                    <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                        <p class="text-white mb-0" style="line-height: 1.8; white-space: pre-line;">@Model.Description</p>
                                    </div>
                                </div>

                                <!-- Event Schedule -->
                                <div class="mb-5">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-calendar-week me-2"></i>Event Schedule</h4>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="p-4 rounded d-flex align-items-center" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                                <div class="me-3">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #6a0dad, #8a2be2);">
                                                        <i class="bi bi-clock text-white" style="font-size: 1.5rem;"></i>
                                                    </div>
                                                </div>
                                                <div>
                                                    <h6 class="text-white fw-bold mb-1">Starts</h6>
                                                    <div class="text-white-50">
                                                        <div><i class="bi bi-calendar2-check me-2"></i>@Model.StartDate.ToString("dddd, MMMM dd, yyyy")</div>
                                                        <div><i class="bi bi-clock me-2"></i>@Model.StartDate.ToString("h:mm tt")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @if (Model.EndDate.HasValue)
                                        {
                                            <div class="col-md-6 mb-3">
                                                <div class="p-4 rounded d-flex align-items-center" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                                    <div class="me-3">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: linear-gradient(135deg, #8a2be2, #9370db);">
                                                            <i class="bi bi-clock-history text-white" style="font-size: 1.5rem;"></i>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <h6 class="text-white fw-bold mb-1">Ends</h6>
                                                        <div class="text-white-50">
                                                            <div><i class="bi bi-calendar2-check me-2"></i>@Model.EndDate.Value.ToString("dddd, MMMM dd, yyyy")</div>
                                                            <div><i class="bi bi-clock me-2"></i>@Model.EndDate.Value.ToString("h:mm tt")</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column - Venue & Deletion Stats -->
                            <div class="col-lg-4">
                                <!-- Venue Information -->
                                <div class="mb-4">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-geo-alt me-2"></i>Venue</h4>
                                    <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                        <div class="d-flex align-items-start mb-3">
                                            <div class="me-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(255,255,255,0.1);">
                                                    <i class="bi bi-building text-white" style="font-size: 1.2rem;"></i>
                                                </div>
                                            </div>
                                            <div>
                                                <h5 class="text-white fw-bold mb-1">@Model.Venue?.Name</h5>
                                                <div class="text-white-50 small">
                                                    <div><i class="bi bi-geo me-1"></i>@Model.Venue?.Address</div>
                                                </div>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.Venue?.Description))
                                        {
                                            <div class="mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.1);">
                                                <p class="text-white-50 small mb-0">@Model.Venue.Description</p>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Deletion Impact -->
                                <div class="mb-4">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-trash me-2"></i>Deletion Impact</h4>
                                    <div class="p-4 rounded" style="background: rgba(220,53,69,0.1); border: 1px solid rgba(220,53,69,0.3);">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="me-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: rgba(220,53,69,0.2);">
                                                    <i class="bi bi-people text-white" style="font-size: 1.2rem;"></i>
                                                </div>
                                            </div>
                                            <div>
                                                <div class="text-white fw-bold h5 mb-1">
                                                    @(Model.Attendees?.Count ?? 0)
                                                </div>
                                                <div class="text-white-50 small">Attendees will be removed</div>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <div class="text-white-50 small">
                                                <i class="bi bi-exclamation-diamond me-1"></i>This action affects:
                                            </div>
                                            <ul class="text-white-50 small mt-2" style="list-style: none; padding-left: 0;">
                                                <li class="mb-1"><i class="bi bi-dot me-1"></i>Event details & description</li>
                                                <li class="mb-1"><i class="bi bi-dot me-1"></i>All attendee records</li>
                                                <li class="mb-1"><i class="bi bi-dot me-1"></i>Event statistics</li>
                                                <li><i class="bi bi-dot me-1"></i>Related notifications</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Event Statistics -->
                        <div class="mt-5 pt-4" style="border-top: 1px solid rgba(255,255,255,0.1);">
                            <h4 class="text-white fw-bold mb-3"><i class="bi bi-bar-chart me-2"></i>Event Statistics</h4>
                            <div class="row">
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="p-3 rounded text-center" style="background: rgba(106,13,173,0.1); border: 1px solid rgba(106,13,173,0.3);">
                                        <div class="text-white fw-bold display-6">
                                            @(Model.Attendees?.Count(a => a.Status == AttendanceStatus.Attending) ?? 0)
                                        </div>
                                        <div class="text-white-50 small">Attending</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="p-3 rounded text-center" style="background: rgba(138,43,226,0.1); border: 1px solid rgba(138,43,226,0.3);">
                                        <div class="text-white fw-bold display-6">
                                            @(Model.Attendees?.Count(a => a.Status == AttendanceStatus.Interested) ?? 0)
                                        </div>
                                        <div class="text-white-50 small">Interested</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="p-3 rounded text-center" style="background: rgba(40,167,69,0.1); border: 1px solid rgba(40,167,69,0.3);">
                                        <div class="text-white fw-bold display-6">
                                            @Model.StartDate.ToString("MMM dd")
                                        </div>
                                        <div class="text-white-50 small">Start Date</div>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6 mb-3">
                                    <div class="p-3 rounded text-center" style="background: rgba(255,193,7,0.1); border: 1px solid rgba(255,193,7,0.3);">
                                        <div class="text-white fw-bold display-6">
                                            @(Model.Venue?.IsPublic == true ? "Public" : "Private")
                                        </div>
                                        <div class="text-white-50 small">Venue Type</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Form -->
                        <div class="mt-5 pt-4" style="border-top: 1px solid rgba(220,53,69,0.3);">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <div class="p-4 rounded text-center" style="background: rgba(220,53,69,0.05); border: 1px solid rgba(220,53,69,0.2);">
                                        <div class="mb-4">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; background: linear-gradient(135deg, #dc3545, #6c757d);">
                                                <i class="bi bi-trash3 text-white" style="font-size: 2rem;"></i>
                                            </div>
                                            <h4 class="text-white fw-bold mb-2">Confirm Deletion</h4>
                                            <p class="text-white-50 mb-4">Please confirm that you want to permanently delete this event. This action cannot be undone.</p>
                                        </div>

                                        <form asp-action="Delete" method="post" id="deleteForm">
                                            <input type="hidden" asp-for="Id" />
                                            <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <button type="submit" class="btn w-100 py-3 text-white fw-bold rounded-pill"
                                                            style="background: linear-gradient(135deg, #dc3545, #c82333); border: none; transition: all 0.2s ease;"
                                                            onclick="return confirmDelete()">
                                                        <i class="bi bi-trash3 me-2"></i>Delete Event
                                                    </button>
                                                </div>
                                                <div class="col-md-6">
                                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn w-100 py-3 text-white fw-bold rounded-pill"
                                                       style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); transition: all 0.2s ease;">
                                                        <i class="bi bi-x-circle me-2"></i>Cancel
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="form-check mt-4">
                                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                                <label class="form-check-label text-white-50 small" for="confirmDelete">
                                                    I understand that this action is permanent and cannot be undone
                                                </label>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge {
        font-weight: 500;
        backdrop-filter: blur(10px);
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.4) !important;
    }

    .btn:first-child:hover {
        box-shadow: 0 6px 20px rgba(220,53,69,0.4) !important;
    }

    .rounded-circle {
        transition: transform 0.3s ease;
    }

        .rounded-circle:hover {
            transform: scale(1.05);
        }

    h1, h2, h3, h4, h5, h6 {
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.4) !important;
        }

    .bg-success {
        background: rgba(40,167,69,0.2) !important;
        border-color: rgba(40,167,69,0.3) !important;
    }

    .bg-info {
        background: rgba(23,162,184,0.2) !important;
        border-color: rgba(23,162,184,0.3) !important;
    }

    .bg-secondary {
        background: rgba(108,117,125,0.2) !important;
        border-color: rgba(108,117,125,0.3) !important;
    }

    .form-check-input {
        background-color: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.3);
    }

        .form-check-input:checked {
            background-color: #dc3545;
            border-color: #dc3545;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(220,53,69,0.25);
        }

    .display-6 {
        font-size: 2.5rem;
        font-weight: 700;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form validation
            const deleteForm = document.getElementById('deleteForm');
            const confirmCheckbox = document.getElementById('confirmDelete');
            const deleteButton = deleteForm.querySelector('button[type="submit"]');

            if (deleteForm && confirmCheckbox) {
                // Disable submit button initially
                deleteButton.disabled = true;
                deleteButton.style.opacity = '0.6';
                deleteButton.style.cursor = 'not-allowed';

                // Enable/disable button based on checkbox
                confirmCheckbox.addEventListener('change', function() {
                    deleteButton.disabled = !this.checked;
                    deleteButton.style.opacity = this.checked ? '1' : '0.6';
                    deleteButton.style.cursor = this.checked ? 'pointer' : 'not-allowed';
                });
            }

            // Add animation to warning card
            const warningCard = document.querySelector('.card[style*="rgba(220,53,69,0.1)"]');
            if (warningCard) {
                warningCard.style.animation = 'pulseWarning 2s infinite';
            }
        });

        function confirmDelete() {
            const checkboxes = [
                document.getElementById('confirmDelete')
            ];

            for (const checkbox of checkboxes) {
                if (checkbox && !checkbox.checked) {
                    alert('Please confirm that you understand this action is permanent.');
                    checkbox.focus();
                    return false;
                }
            }

            return confirm('⚠️ FINAL WARNING ⚠️\n\nAre you absolutely sure you want to delete this event?\n\nThis will permanently delete:\n• All event details\n• All attendee records\n• All event statistics\n\nThis action cannot be undone!');
        }

        // Add CSS animation for warning pulse
        const style = document.createElement('style');
        style.textContent = `
        `;
        document.head.appendChild(style);
    </script>
}