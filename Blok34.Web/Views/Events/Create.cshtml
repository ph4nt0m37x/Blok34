        .datetimepicker-container .day:hover, .datetimepicker-container .hour:hover, .datetimepicker-container .minute:hover, .datetimepicker-container .month:hover, .datetimepicker-container .year:hover, .datetimepicker-container .decade:hover, .datetimepicker-container .picker-switch:hover, .datetimepicker-container .prev:hover, .datetimepicker-container .next:hover {
