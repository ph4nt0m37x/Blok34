@model Blok34.Domain.DomainModels.Event
@using Blok34.Domain.Enums
@{
    ViewData["Title"] = "Create Event";
}

<div class="d-flex align-items-start justify-content-start" style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 col-sm-12">
                <div class="card border-0 shadow" style="background: rgba(255,255,255,0.07); backdrop-filter: blur(12px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15); margin-bottom: 2rem;">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-2">
                                <defs><linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4B0082" /><stop offset="100%" stop-color="#6a0dad" /></linearGradient></defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-1">Create New Event</h3>
                            <p class="text-white-50">Organize and share your event with the community</p>
                        </div>

                        <form asp-action="Create" method="post" id="eventForm">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-4" role="alert"></div>

                            <input type="hidden" asp-for="CreatedByUserId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />

                            <div class="mb-3 position-relative">
                                <label asp-for="Title" class="form-label text-white fw-medium mb-1"><i class="bi bi-calendar-event me-2"></i>Event Title</label>
                                <div class="position-relative">
                                    <i class="bi bi-pencil position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Title" class="form-control bg-transparent text-white py-2 rounded-pill ps-5" style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;" placeholder="Enter event title" aria-required="true" />
                                </div>
                                <span asp-validation-for="Title" class="text-danger d-block mt-1"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Category" class="form-label text-white fw-medium mb-2"><i class="bi bi-tags me-2"></i>Event Category</label>
                                <div class="position-relative">
                                    <div class="custom-select-wrapper">
                                        <div class="custom-select-trigger d-flex align-items-center justify-content-between bg-transparent text-white py-2 px-3 rounded-pill" style="border: 1px solid rgba(255,255,255,0.3); cursor: pointer; transition: all 0.2s ease;" id="categoryTrigger">
                                            <div class="d-flex align-items-center"><i class="bi bi-tag me-2 text-white-50"></i><span id="selectedCategory">Select a category</span></div>
                                            <i class="bi bi-chevron-down text-white-50" id="categoryDropdownArrow"></i>
                                        </div>
                                        <div class="custom-select-options shadow" style="background: rgba(30, 30, 46, 0.98); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; margin-top: 0.5rem; padding: 0.5rem; display: none; position: absolute; width: 100%; z-index: 1000;" id="categoryOptions">
                                            @foreach (var category in Html.GetEnumSelectList<EventCategory>())
                                            {
                                                <div class="custom-option d-flex align-items-center text-white py-2 px-3 rounded" style="margin: 0.1rem 0; cursor: pointer; transition: all 0.2s ease;" data-value="@category.Value">
                                                    <div class="me-2 d-flex align-items-center justify-content-center rounded" style="width: 28px; height: 28px; background: rgba(255,255,255,0.1);"><i class="bi bi-calendar-check" style="font-size: 0.8rem;"></i></div><span>@category.Text</span>
                                                </div>
                                            }
                                        </div>
                                        <select asp-for="Category" asp-items="Html.GetEnumSelectList<EventCategory>()" class="d-none" id="hiddenCategorySelect" aria-required="true"><option value="" selected disabled>Select a category</option></select>
                                    </div>
                                </div>
                                <span asp-validation-for="Category" class="text-danger d-block mt-1" id="categoryError"></span>
                            </div>

                            <div class="mb-3 position-relative">
                                <label asp-for="Description" class="form-label text-white fw-medium mb-1"><i class="bi bi-text-paragraph me-2"></i>Description</label>
                                <div class="position-relative">
                                    <i class="bi bi-text-left position-absolute top-0 start-0 ms-3 mt-3 text-white-50"></i>
                                    <textarea asp-for="Description" class="form-control bg-transparent text-white py-2 rounded-4 ps-5" style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; min-height: 120px;" placeholder="Describe your event (agenda, activities, etc.)" aria-required="true"></textarea>
                                </div>
                                <span asp-validation-for="Description" class="text-danger d-block mt-1"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="StartDate" class="form-label text-white fw-medium mb-2 d-block"><i class="bi bi-clock me-2"></i>Start Date & Time</label>
                                <input type="hidden" asp-for="StartDate" id="startDateTimeInput" />
                                <div class="datetimepicker-container rounded-4 p-3 mb-2" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15);">
                                    <div class="row"><div class="col-md-12"><div id="startDateTimePicker"></div></div></div>
                                </div>
                                <div class="mt-2 mb-1"><small class="text-white-50"><i class="bi bi-calendar2-check me-1"></i>Selected: <span id="startDateTimeDisplay" class="fw-medium text-white">Not selected</span></small></div>
                                <div id="startDateError" class="text-danger d-block mt-1 small"></div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="EndDate" class="form-label text-white fw-medium mb-2 d-block"><i class="bi bi-clock-history me-2"></i>End Date & Time</label>
                                <input type="hidden" asp-for="EndDate" id="endDateTimeInput" />
                                <div class="datetimepicker-container rounded-4 p-3 mb-2" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15);">
                                    <div class="row"><div class="col-md-12"><div id="endDateTimePicker"></div></div></div>
                                </div>
                                <div class="mt-2 mb-1"><small class="text-white-50"><i class="bi bi-calendar2-check me-1"></i>Selected: <span id="endDateTimeDisplay" class="fw-medium text-white">Not selected</span></small></div>
                                <div id="endDateError" class="text-danger d-block mt-1 small"></div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="VenueId" class="form-label text-white fw-medium mb-2"><i class="bi bi-geo-alt me-2"></i>Select Venue</label>
                                <div class="position-relative">
                                    <div class="custom-select-wrapper">
                                        <div class="custom-select-trigger d-flex align-items-center justify-content-between bg-transparent text-white py-2 px-3 rounded-pill" style="border: 1px solid rgba(255,255,255,0.3); cursor: pointer; transition: all 0.2s ease;" id="venueTrigger">
                                            <div class="d-flex align-items-center"><i class="bi bi-building me-2 text-white-50"></i><span id="selectedVenue">Select a venue</span></div>
                                            <i class="bi bi-chevron-down text-white-50" id="venueDropdownArrow"></i>
                                        </div>
                                        <div class="custom-select-options shadow" style="background: rgba(30, 30, 46, 0.98); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; margin-top: 0.5rem; padding: 0.5rem; display: none; position: absolute; width: 100%; z-index: 1000;" id="venueOptions">
                                            @if (ViewBag.VenueId != null && ((IEnumerable<SelectListItem>)ViewBag.VenueId).Any())
                                            {
                                                foreach (var venue in ViewBag.VenueId)
                                                {
                                                    <div class="custom-option d-flex align-items-center text-white py-2 px-3 rounded" style="margin: 0.1rem 0; cursor: pointer; transition: all 0.2s ease;" data-value="@venue.Value">
                                                        <div class="me-2 d-flex align-items-center justify-content-center rounded" style="width: 28px; height: 28px; background: rgba(255,255,255,0.1);"><i class="bi bi-building" style="font-size: 0.8rem;"></i></div>
                                                        <div><div class="fw-medium">@venue.Text</div><small class="text-white-50" style="font-size: 0.75rem;">Select this venue</small></div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-center py-3">
                                                    <i class="bi bi-building-slash text-white-50 display-6 mb-2"></i>
                                                    <p class="text-white-50 mb-1">No venues available</p>
                                                    <a asp-controller="Venues" asp-action="Create" class="text-decoration-none" style="color: #7fa3e4;"><i class="bi bi-plus-circle me-1"></i>Create a venue first</a>
                                                </div>
                                            }
                                        </div>
                                        <select asp-for="VenueId" asp-items="ViewBag.VenueId" class="d-none" id="hiddenVenueSelect" aria-required="true"><option value="" selected disabled>Select a venue</option></select>
                                    </div>
                                </div>
                                <span asp-validation-for="VenueId" class="text-danger d-block mt-1" id="venueError"></span>
                            </div>

                            <div class="mb-4 p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                <div class="d-flex align-items-center mb-2"><i class="bi bi-info-circle text-info me-2" style="font-size: 1.2rem;"></i><h6 class="text-white mb-0">Event Tips</h6></div>
                                <ul class="text-white-50 small mb-0 ps-3">
                                    <li>Choose a descriptive title that captures the event's essence</li>
                                    <li>Select the appropriate category to help attendees find your event</li>
                                    <li>Provide clear details about the schedule and activities</li>
                                    <li>Make sure your venue can accommodate the expected number of attendees</li>
                                    <li>Double-check dates and times for accuracy</li>
                                    <li>Consider accessibility and facilities available at the venue</li>
                                </ul>
                            </div>

                            <button type="submit" class="btn w-100 py-2 mb-2 text-white fw-medium rounded-pill fw-bold" style="background: linear-gradient(135deg, #6a0dad, #8a2be2); border: none; font-size: 0.95rem; transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(106,13,173,0.3);" id="submitBtn"><i class="bi bi-plus-circle me-2"></i>Create Event</button>

                            <div class="text-center mt-3">
                                <a asp-action="Index" class="text-decoration-none fw-medium" style="color: #7fa3e4"><i class="bi bi-arrow-left me-1"></i>Back to Events List</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
