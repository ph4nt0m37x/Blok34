@using System.Security.Claims
@model IEnumerable<Blok34.Domain.DomainModels.Venue>

@{
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var now = DateTime.UtcNow;
    var totalVenues = Model?.Count() ?? 0;
    var publicVenues = Model?.Count(v => v.IsPublic) ?? 0;
    var privateVenues = Model?.Count(v => !v.IsPublic) ?? 0;
}

<div class="d-flex align-items-center justify-content-center"
     style="background: linear-gradient(135deg, #1e3c72, #6a0dad); min-height: 100vh; padding-top: 80px;">

    <div class="container py-5">
        <!-- Header Section -->
        <div class="text-center mb-5">
            <h2 class="text-white fw-bold mb-3">
                <i class="bi bi-building me-2"></i>My Venues
            </h2>
            <p class="text-white-50 lead">All venues registered by you</p>

            <!-- Stats Section -->
            <div class="d-flex justify-content-center gap-4 mb-4">
                <div class="text-center">
                    <div class="text-white fw-bold fs-4">@totalVenues</div>
                    <div class="text-white-50 small">Total Venues</div>
                </div>
                <div class="text-center">
                    <div class="text-white fw-bold fs-4">@publicVenues</div>
                    <div class="text-white-50 small">Public</div>
                </div>
                <div class="text-center">
                    <div class="text-white fw-bold fs-4">@privateVenues</div>
                    <div class="text-white-50 small">Private</div>
                </div>
                <div class="text-center">
                    @{
                        var totalEvents = Model?.Sum(v => v.Events?.Count ?? 0) ?? 0;
                    }
                    <div class="text-white fw-bold fs-4">@totalEvents</div>
                    <div class="text-white-50 small">Total Events</div>
                </div>
            </div>

            <!-- Create New Venue Button -->
            <div class="mb-5">
                <a asp-controller="Venues" asp-action="Create"
                   class="btn rounded-pill px-5 py-3 fw-bold btn-glow"
                   style="background: linear-gradient(135deg, #8a2be2, #5D3FD3); color: white; border: none;">
                    <i class="bi bi-plus-circle me-2"></i>Register New Venue
                </a>
            </div>
        </div>

        <!-- No Venues Message -->
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="card border-0 shadow-lg mx-auto"
                     style="max-width: 500px; background: rgba(255,255,255,0.05); backdrop-filter: blur(10px);">
                    <div class="card-body py-5">
                        <i class="bi bi-building display-1 text-white-50 mb-4"></i>
                        <h4 class="text-white mb-3">No Venues Registered Yet</h4>
                        <p class="text-white-50 mb-4">You haven't registered any venues. Start by registering your first venue!</p>
                        <a asp-controller="Venues" asp-action="Create"
                           class="btn rounded-pill px-4 py-2 fw-bold"
                           style="background: linear-gradient(135deg, #6a0dad, #8a2be2); color: white;">
                            <i class="bi bi-plus-circle me-2"></i>Register Your First Venue
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- Venues Grid -->
        @if (Model.Any())
        {
            <div class="mb-5">
                <!-- Filter Tabs -->
                <div class="d-flex justify-content-center mb-5">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-light rounded-pill me-2 active" data-filter="all">
                            <i class="bi bi-grid me-2"></i>All Venues (@totalVenues)
                        </button>
                        <button type="button" class="btn btn-outline-light rounded-pill me-2" data-filter="public">
                            <i class="bi bi-eye me-2"></i>Public (@publicVenues)
                        </button>
                        <button type="button" class="btn btn-outline-light rounded-pill" data-filter="private">
                            <i class="bi bi-shield-lock me-2"></i>Private (@privateVenues)
                        </button>
                    </div>
                </div>

                <div class="row g-4 venues-grid">
                    @foreach (var venue in Model)
                    {
                        var venueClass = venue.IsPublic ? "public" : "private";
                        var upcomingEvents = venue.Events?.Count(e => e.StartDate > now) ?? 0;
                        var totalVenueEvents = venue.Events?.Count ?? 0;

                        <div class="col-md-6 col-lg-4 col-xl-3 venue-card @venueClass">
                            <div class="card h-100 border-0 shadow-lg"
                                 style="background: rgba(255,255,255,0.07); backdrop-filter: blur(12px); border-radius: 15px; border: 1px solid rgba(255,255,255,0.15); overflow: hidden;">

                                <!-- Venue Banner -->
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(venue.BannerPath))
                                    {
                                        <img src="@venue.BannerPath" class="card-img-top" alt="@venue.Name" style="height: 180px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top" style="height: 180px; background: linear-gradient(135deg, #8a2be2, #5D3FD3);"></div>
                                    }

                                    <!-- Venue Status Badge -->
                                    <div class="position-absolute top-0 end-0 mt-3 me-3">
                                        @if (venue.IsPublic)
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background: rgba(25, 135, 84, 0.3); border: 1px solid rgba(25, 135, 84, 0.5); color: white;">
                                                <i class="bi bi-eye me-1"></i>Public
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background: rgba(13, 110, 253, 0.3); border: 1px solid rgba(13, 110, 253, 0.5); color: white;">
                                                <i class="bi bi-shield-lock me-1"></i>Private
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="card-body p-4">
                                    <!-- Venue Name -->
                                    <h5 class="card-title text-white mb-2">@venue.Name</h5>

                                    <!-- Venue Category -->
                                    <div class="mb-3">
                                        <span class="badge px-3 py-1 rounded-pill"
                                              style="background: rgba(138, 43, 226, 0.2); color: white;">
                                            <i class="bi bi-tag me-1"></i>@venue.Category
                                        </span>
                                    </div>

                                    <!-- Venue Description -->
                                    @if (!string.IsNullOrEmpty(venue.Description))
                                    {
                                        <p class="text-white-50 small mb-3">
                                            @(venue.Description.Length > 100 ? venue.Description.Substring(0, 100) + "..." : venue.Description)
                                        </p>
                                    }

                                    <!-- Venue Details -->
                                    <div class="mb-4">
                                        <div class="d-flex align-items-center text-white-50 mb-2">
                                            <div class="me-3" style="width: 24px; height: 24px; background: rgba(106, 13, 173, 0.2); border-radius: 50%; display: flex; align-items-center; justify-content: center;">
                                                <i class="bi bi-geo-alt text-white" style="font-size: 0.8rem;"></i>
                                            </div>
                                            <small>
                                                @if (!string.IsNullOrEmpty(venue.Address))
                                                {
                                                    @(venue.Address.Length > 30 ? venue.Address.Substring(0, 30) + "..." : venue.Address)
                                                }
                                                else
                                                {
                                                    <span class="text-warning">No address</span>
                                                }
                                            </small>
                                        </div>

                                        <div class="d-flex align-items-center text-white-50 mb-2">
                                            <div class="me-3" style="width: 24px; height: 24px; background: rgba(138, 43, 226, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-telephone text-white" style="font-size: 0.8rem;"></i>
                                            </div>
                                            <small>
                                                @if (!string.IsNullOrEmpty(venue.Phone))
                                                {
                                                    @venue.Phone
                                                }
                                                else
                                                {
                                                    <span class="text-warning">No phone</span>
                                                }
                                            </small>
                                        </div>

                                        <div class="d-flex align-items-center text-white-50">
                                            <div class="me-3" style="width: 24px; height: 24px; background: rgba(75, 0, 130, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-calendar-event text-white" style="font-size: 0.8rem;"></i>
                                            </div>
                                            <small>@totalVenueEvents events (@upcomingEvents upcoming)</small>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-flex gap-2">
                                        <!-- View Details Button -->
                                        <a asp-controller="Venues" asp-action="Details" asp-route-id="@venue.Id"
                                           class="btn btn-sm flex-fill rounded-pill py-2"
                                           style="background: rgba(138, 43, 226, 0.2); border: 1px solid rgba(138, 43, 226, 0.5); color: white;">
                                            <i class="bi bi-eye me-2"></i>View Details
                                        </a>

                                        <!-- Edit Button -->
                                        <a asp-controller="Venues" asp-action="Edit" asp-route-id="@venue.Id"
                                           class="btn btn-sm rounded-pill py-2"
                                           style="width: 40px; background: rgba(255, 193, 7, 0.2); border: 1px solid rgba(255, 193, 7, 0.5); color: white;"
                                           title="Edit Venue">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete Button - Direct link to your delete page -->
                                        <a asp-controller="Venues" asp-action="Delete" asp-route-id="@venue.Id"
                                           class="btn btn-sm rounded-pill py-2"
                                           style="width: 40px; background: rgba(220, 53, 69, 0.2); border: 1px solid rgba(220, 53, 69, 0.5); color: white;"
                                           title="Delete Venue">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Back Button -->
        <div class="text-center mt-5 py-4">
            <a href="javascript:history.back()" class="btn btn-lg rounded-pill px-5 py-3 fw-bold"
               style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: white;">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>
</div>

<style>
    body, html {
        margin: 0;
        padding: 0;
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.3) !important;
            border-color: rgba(138, 43, 226, 0.3) !important;
        }

    .btn-group .btn.active {
        background: linear-gradient(135deg, #8a2be2, #5D3FD3) !important;
        border-color: #8a2be2 !important;
    }

    .btn-outline-light:hover {
        background: rgba(255,255,255,0.1) !important;
    }

    .btn-glow:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(138, 43, 226, 0.4);
        transition: all 0.2s ease;
    }

    /* Venue type specific styles */
    .venue-card.public .card {
        border-left: 4px solid rgba(25, 135, 84, 0.5) !important;
    }

    .venue-card.private .card {
        border-left: 4px solid rgba(13, 110, 253, 0.5) !important;
    }

    /* Delete button hover effect */
    a[title="Delete Venue"]:hover {
        background: rgba(220, 53, 69, 0.3) !important;
        border-color: rgba(220, 53, 69, 0.7) !important;
        transform: scale(1.05);
        transition: all 0.2s ease;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.05);
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient(135deg, #6a0dad, #8a2be2);
        border-radius: 5px;
    }
</style>

<!-- REMOVED: Duplicate Bootstrap JS import from here -->
<!-- Scripts for filtering and animations -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize filter buttons
        const filterButtons = document.querySelectorAll('[data-filter]');
        const venueCards = document.querySelectorAll('.venue-card');

        // Add fade-in animation to cards
        venueCards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';

            setTimeout(() => {
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });

        // Filter functionality
        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Update active button
                filterButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');

                // Filter cards
                venueCards.forEach(card => {
                    if (filter === 'all' || card.classList.contains(filter)) {
                        card.style.display = 'block';
                        setTimeout(() => {
                            card.style.opacity = '1';
                            card.style.transform = 'translateY(0)';
                        }, 10);
                    } else {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            card.style.display = 'none';
                        }, 300);
                    }
                });
            });
        });

        // Initialize tooltips - check if Bootstrap is available
        const initTooltips = () => {
            const tooltips = document.querySelectorAll('[title]');
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                tooltips.forEach(element => {
                    new bootstrap.Tooltip(element);
                });
            } else {
                // Fallback if Bootstrap not available
                tooltips.forEach(element => {
                    element.addEventListener('mouseenter', function() {
                        this.setAttribute('data-bs-original-title', this.getAttribute('title'));
                    });
                });
            }
        };

        // Try to initialize tooltips
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTooltips);
        } else {
            setTimeout(initTooltips, 100); // Small delay to ensure Bootstrap is loaded
        }

        // Add hover effects to cards
        const cards = document.querySelectorAll('.card');
        cards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
                this.style.boxShadow = '0 15px 30px rgba(0,0,0,0.3)';
                this.style.borderColor = 'rgba(138, 43, 226, 0.3)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
                this.style.boxShadow = '0 0 15px rgba(0,0,0,0.1)';
                this.style.borderColor = 'rgba(255,255,255,0.15)';
            });
        });
    });
</script>