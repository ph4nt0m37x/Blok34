@using Blok34.Domain.Enums
@model Blok34.Domain.DomainModels.Venue

@{
    ViewData["Title"] = "Edit Venue";
}

<div class="d-flex align-items-start justify-content-start"
     style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 col-sm-12">
                <!-- Glassmorphism Card -->
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 2rem;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-4">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-2">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-1">Edit Venue</h3>
                            <p class="text-white-50">Update your venue information</p>
                        </div>

                        <!-- Venue Form -->
                        <form asp-action="Edit" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-4"
                                 role="alert">
                            </div>

                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="VenueManagerId" />
                            <input type="hidden" asp-for="IsPublic" />
                            <input type="hidden" asp-for="BannerPath" id="currentBannerPath" />

                            <!-- Venue Name -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Name" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-building me-2"></i>Venue Name
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-building position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Name"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter venue name"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Category Dropdown - Custom Styled -->
                            <div class="mb-3">
                                <label asp-for="Category" class="form-label text-white fw-medium mb-2">
                                    <i class="bi bi-tags me-2"></i>Venue Category
                                </label>
                                <div class="position-relative">
                                    <!-- Custom dropdown container -->
                                    <div class="custom-select-wrapper">
                                        <div class="custom-select-trigger d-flex align-items-center justify-content-between bg-transparent text-white py-2 px-3 rounded-pill"
                                             style="border: 1px solid rgba(255,255,255,0.3); cursor: pointer; transition: all 0.2s ease;"
                                             id="categoryTrigger">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-tag me-2 text-white-50"></i>
                                                <span id="selectedCategory">
                                                    @Model.Category.ToString()
                                                </span>
                                            </div>
                                            <i class="bi bi-chevron-down text-white-50" id="dropdownArrow"></i>
                                        </div>

                                        <!-- Custom dropdown menu -->
                                        <div class="custom-select-options shadow"
                                             style="background: rgba(30, 30, 46, 0.98);
                                                    backdrop-filter: blur(10px);
                                                    border: 1px solid rgba(255,255,255,0.15);
                                                    border-radius: 12px;
                                                    margin-top: 0.5rem;
                                                    padding: 0.5rem;
                                                    display: none;
                                                    position: absolute;
                                                    width: 100%;
                                                    z-index: 1000;"
                                             id="categoryOptions">
                                            @foreach (var category in Html.GetEnumSelectList<VenueCategory>())
                                            {
                                                <div class="custom-option d-flex align-items-center text-white py-2 px-3 rounded"
                                                     style="margin: 0.1rem 0; cursor: pointer; transition: all 0.2s ease;"
                                                     data-value="@category.Value">
                                                    <div class="me-2 d-flex align-items-center justify-content-center rounded"
                                                         style="width: 28px; height: 28px; background: rgba(255,255,255,0.1);">
                                                        <i class="bi bi-geo-alt" style="font-size: 0.8rem;"></i>
                                                    </div>
                                                    <span>@category.Text</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Hidden select for form submission -->
                                        <select asp-for="Category"
                                                asp-items="Html.GetEnumSelectList<VenueCategory>()"
                                                class="d-none"
                                                id="hiddenCategorySelect"
                                                aria-required="true">
                                            <option value="" disabled>Select a category</option>
                                        </select>
                                    </div>
                                </div>
                                <span asp-validation-for="Category" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Description -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Description" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-text-paragraph me-2"></i>Description
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-text-left position-absolute top-0 start-0 ms-3 mt-3 text-white-50"></i>
                                    <textarea asp-for="Description"
                                              class="form-control bg-transparent text-white py-2 rounded-4 ps-5"
                                              style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; min-height: 100px;"
                                              placeholder="Describe your venue (facilities, atmosphere, etc.)"
                                              aria-required="false"></textarea>
                                </div>
                                <span asp-validation-for="Description" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Address -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Address" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-geo-alt me-2"></i>Address
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-geo-alt position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Address"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Full address of the venue"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Phone" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-telephone me-2"></i>Contact Phone
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-telephone position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Phone"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Phone number for inquiries"
                                           aria-required="false" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Banner Image Upload -->
                            <div class="mb-4">
                                <label class="form-label text-white fw-medium mb-2">
                                    <i class="bi bi-image me-2"></i>Venue Banner Image
                                </label>

                                <!-- Current Image Display -->
                                @if (!string.IsNullOrEmpty(Model.BannerPath))
                                {
                                    <div class="mb-3">
                                        <div class="d-flex align-items-center mb-2">
                                            <span class="badge bg-info bg-opacity-25 text-info px-3 py-1 rounded-pill me-2">
                                                <i class="bi bi-image me-1"></i>Current Banner
                                            </span>
                                            <small class="text-white-50">Click "Choose New Banner" below to change</small>
                                        </div>
                                        <div class="current-image-container mb-3 rounded overflow-hidden"
                                             style="border: 2px solid rgba(255,255,255,0.2); max-height: 200px;">
                                            <img src="@Model.BannerPath"
                                                 alt="Current banner"
                                                 class="w-100 h-100 object-fit-cover"
                                                 id="currentBannerImage"
                                                 onerror="this.style.display='none'; document.getElementById('defaultPreview').classList.remove('d-none');" />
                                        </div>
                                    </div>
                                }

                                <!-- Image Upload Area -->
                                <div class="image-upload-area mb-3 rounded @(string.IsNullOrEmpty(Model.BannerPath) ? "" : "d-none")"
                                     style="border: 2px dashed rgba(255,255,255,0.3);
                                            background: rgba(255,255,255,0.05);
                                            min-height: 200px;
                                            cursor: pointer;
                                            position: relative;
                                            overflow: hidden;"
                                     id="uploadArea">

                                    <!-- Default Preview -->
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4"
                                         id="defaultPreview">
                                        <i class="bi bi-cloud-arrow-up display-4 text-white-50 mb-3"></i>
                                        <p class="text-white-50 mb-2 text-center">Click or drag to upload banner image</p>
                                        <small class="text-white-50">Recommended: 1920x400 pixels</small>
                                    </div>

                                    <!-- New Image Preview -->
                                    <img id="imagePreview"
                                         class="w-100 h-100 object-fit-cover d-none"
                                         style="position: absolute; top: 0; left: 0; object-fit: cover;" />

                                    <!-- Remove New Image Button -->
                                    <button type="button"
                                            class="btn btn-sm position-absolute top-0 end-0 m-2 rounded-circle d-none"
                                            id="removeNewImageBtn"
                                            style="background: rgba(220, 53, 69, 0.8);
                                                   border: none;
                                                   width: 32px;
                                                   height: 32px;">
                                        <i class="bi bi-x text-white"></i>
                                    </button>

                                    <!-- Hidden File Input -->
                                    <input type="file"
                                           name="BannerFile"
                                           id="bannerFileInput"
                                           accept="image/*"
                                           class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" />
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    @if (!string.IsNullOrEmpty(Model.BannerPath))
                                    {
                                        <div>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary rounded-pill me-2"
                                                    id="changeImageBtn"
                                                    style="font-size: 0.85rem;">
                                                <i class="bi bi-arrow-repeat me-1"></i>Choose New Banner
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-pill"
                                                    id="removeCurrentImageBtn"
                                                    style="font-size: 0.85rem;">
                                                <i class="bi bi-trash me-1"></i>Remove Current Banner
                                            </button>
                                        </div>
                                    }
                                    <small class="text-white-50" id="fileSizeInfo"></small>
                                </div>

                                <div class="d-flex align-items-center justify-content-between">
                                    <small class="text-white-50">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Upload a new banner image for your venue (JPG, PNG, GIF)
                                    </small>
                                </div>
                                <span class="text-danger d-block mt-1" id="fileError"></span>
                            </div>

                            <!-- Venue Type Display (Read-only) -->
                            <div class="mb-4 p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-info-circle text-info me-2" style="font-size: 1.2rem;"></i>
                                    <h6 class="text-white mb-0">Venue Type</h6>
                                </div>

                                @if (Model.IsPublic)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill me-3">
                                            <i class="bi bi-eye me-1"></i>Public Venue
                                        </div>
                                        <div class="text-white-50 small">
                                            <i class="bi bi-info-circle me-1"></i>
                                            This is a public venue. All users can create events here.
                                            <span class="d-block mt-1 text-warning">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Venue type cannot be changed after creation.
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge bg-primary bg-opacity-25 text-primary px-3 py-2 rounded-pill me-3">
                                            <i class="bi bi-shield-lock me-1"></i>Private Venue
                                        </div>
                                        <div class="text-white-50 small">
                                            <i class="bi bi-info-circle me-1"></i>
                                            This is a private venue. Only you can create events here.
                                            <span class="d-block mt-1 text-warning">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Venue type cannot be changed after creation.
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Submit Button -->
                            <button type="submit"
                                    class="btn w-100 py-2 mb-2 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-save me-2"></i>Save Changes
                            </button>

                            <!-- Back Link -->
                            <div class="text-center mt-3">
                                <a asp-action="Index"
                                   class="text-decoration-none fw-medium"
                                   style="color: #7fa3e4">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Venues List
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Information Card -->
                <div class="card border-0 shadow mt-3"
                     style="background: rgba(255,255,255,0.05);
                            backdrop-filter: blur(12px);
                            border-radius: 16px;
                            border: 1px solid rgba(255,255,255,0.1);">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-info-circle text-info me-2" style="font-size: 1.2rem;"></i>
                            <h6 class="text-white mb-0">Editing Information</h6>
                        </div>
                        <ul class="text-white-50 small mb-0 ps-3">
                            <li>Update your venue details to keep information current</li>
                            <li>Venue type (public/private) cannot be changed after creation</li>
                            <li>You can upload a new banner image or keep the current one</li>
                            <li>Make sure contact information is accurate for event organizers</li>
                            <li>A good banner image helps attract more event organizers</li>
                            <li>All changes are saved immediately when you click "Save Changes"</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Consistent with other pages styling */
    .form-control:focus,
    .form-control:focus-within {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    textarea.form-control {
        resize: vertical;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }

    /* Button hover effect */
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(106,13,173,0.4) !important;
    }

    .btn-outline-primary {
        border-color: rgba(138, 43, 226, 0.5);
        color: rgba(138, 43, 226, 0.8);
    }

        .btn-outline-primary:hover {
            background-color: rgba(138, 43, 226, 0.1);
            border-color: rgba(138, 43, 226, 0.8);
            color: rgba(138, 43, 226, 1);
        }

    .btn-outline-danger {
        border-color: rgba(220, 53, 69, 0.5);
        color: rgba(220, 53, 69, 0.8);
    }

        .btn-outline-danger:hover {
            background-color: rgba(220, 53, 69, 0.1);
            border-color: rgba(220, 53, 69, 0.8);
            color: rgba(220, 53, 69, 1);
        }

    /* Badge styling */
    .badge {
        font-weight: 500;
    }

    /* List styling */
    ul {
        padding-left: 1.25rem;
    }

    li {
        margin-bottom: 0.25rem;
    }

    /* Custom Select Styling */
    .custom-select-wrapper {
        position: relative;
    }

    .custom-select-trigger:hover {
        background: rgba(255,255,255,0.05) !important;
        border-color: rgba(138, 43, 226, 0.3) !important;
    }

    .custom-select-trigger:focus {
        background: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
    }

    .custom-select-options {
        max-height: 250px;
        overflow-y: auto;
    }

    .custom-option:hover {
        background: rgba(138, 43, 226, 0.25) !important;
        transform: translateX(5px);
    }

        .custom-option:hover .me-2 {
            background: rgba(138, 43, 226, 0.4) !important;
            transform: scale(1.1);
        }

    /* Scrollbar styling */
    .custom-select-options::-webkit-scrollbar {
        width: 6px;
    }

    .custom-select-options::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.05);
        border-radius: 3px;
    }

    .custom-select-options::-webkit-scrollbar-thumb {
        background: rgba(138, 43, 226, 0.5);
        border-radius: 3px;
    }

        .custom-select-options::-webkit-scrollbar-thumb:hover {
            background: rgba(138, 43, 226, 0.7);
        }

    /* Image upload area styling */
    .image-upload-area:hover {
        border-color: rgba(138, 43, 226, 0.5) !important;
        background: rgba(138, 43, 226, 0.05) !important;
    }

    /* Current image container */
    .current-image-container {
        transition: all 0.3s ease;
    }

        .current-image-container:hover {
            border-color: rgba(138, 43, 226, 0.5) !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(106,13,173,0.3);
        }

    /* Object fit utility */
    .object-fit-cover {
        object-fit: cover;
    }

    /* Cursor pointer utility */
    .cursor-pointer {
        cursor: pointer;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Category dropdown functionality
        const categoryTrigger = document.getElementById('categoryTrigger');
        const categoryOptions = document.getElementById('categoryOptions');
        const dropdownArrow = document.getElementById('dropdownArrow');
        const selectedCategory = document.getElementById('selectedCategory');
        const hiddenSelect = document.getElementById('hiddenCategorySelect');
        const customOptions = document.querySelectorAll('.custom-option');

        // Initialize selected category if already set
        if (hiddenSelect.value) {
            selectedCategory.textContent = hiddenSelect.options[hiddenSelect.selectedIndex].text;
        }

        // Toggle dropdown on trigger click
        if (categoryTrigger) {
            categoryTrigger.addEventListener('click', function(e) {
                e.stopPropagation();

                if (categoryOptions.style.display === 'block') {
                    categoryOptions.style.display = 'none';
                    dropdownArrow.classList.remove('bi-chevron-up');
                    dropdownArrow.classList.add('bi-chevron-down');
                } else {
                    categoryOptions.style.display = 'block';
                    dropdownArrow.classList.remove('bi-chevron-down');
                    dropdownArrow.classList.add('bi-chevron-up');
                }
            });
        }

        // Handle option selection
        customOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.stopPropagation();

                const value = this.getAttribute('data-value');
                const text = this.querySelector('span').textContent;

                selectedCategory.textContent = text;
                hiddenSelect.value = value;
                categoryOptions.style.display = 'none';
                dropdownArrow.classList.remove('bi-chevron-up');
                dropdownArrow.classList.add('bi-chevron-down');
                categoryTrigger.style.background = 'rgba(138, 43, 226, 0.1)';
                categoryTrigger.style.borderColor = 'rgba(138, 43, 226, 0.4)';
                hiddenSelect.dispatchEvent(new Event('change'));
            });
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function() {
            if (categoryOptions) {
                categoryOptions.style.display = 'none';
                dropdownArrow.classList.remove('bi-chevron-up');
                dropdownArrow.classList.add('bi-chevron-down');
            }
        });

        // Prevent dropdown from closing when clicking inside it
        if (categoryOptions) {
            categoryOptions.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        }

        // Banner Image Upload Functionality
        const bannerFileInput = document.getElementById('bannerFileInput');
        const imagePreview = document.getElementById('imagePreview');
        const defaultPreview = document.getElementById('defaultPreview');
        const removeNewImageBtn = document.getElementById('removeNewImageBtn');
        const fileSizeInfo = document.getElementById('fileSizeInfo');
        const fileError = document.getElementById('fileError');
        const uploadArea = document.getElementById('uploadArea');
        const changeImageBtn = document.getElementById('changeImageBtn');
        const removeCurrentImageBtn = document.getElementById('removeCurrentImageBtn');
        const currentBannerPath = document.getElementById('currentBannerPath');
        const currentBannerImage = document.getElementById('currentBannerImage');
        const currentImageContainer = document.querySelector('.current-image-container');

        // Handle file selection
        bannerFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];

            if (file) {
                // Validate file type
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    fileError.textContent = 'Please select a valid image file (JPG, PNG, GIF, WebP).';
                    bannerFileInput.value = '';
                    return;
                }

                // Validate file size (max 5MB)
                const maxSize = 5 * 1024 * 1024; // 5MB
                if (file.size > maxSize) {
                    fileError.textContent = 'File size must be less than 5MB.';
                    bannerFileInput.value = '';
                    return;
                }

                // Clear any previous errors
                fileError.textContent = '';

                // Show file size
                const fileSize = file.size > 1024 * 1024
                    ? (file.size / (1024 * 1024)).toFixed(2) + ' MB'
                    : (file.size / 1024).toFixed(2) + ' KB';
                fileSizeInfo.textContent = fileSize;

                // Create preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    imagePreview.classList.remove('d-none');
                    defaultPreview.classList.add('d-none');
                    removeNewImageBtn.classList.remove('d-none');

                    // Hide current banner image when new one is uploaded
                    if (currentBannerImage) {
                        currentBannerImage.style.display = 'none';
                    }
                    if (currentImageContainer) {
                        currentImageContainer.style.display = 'none';
                    }
                    if (changeImageBtn) {
                        changeImageBtn.style.display = 'none';
                    }
                    if (removeCurrentImageBtn) {
                        removeCurrentImageBtn.style.display = 'none';
                    }
                }
                reader.readAsDataURL(file);

                // Visual feedback
                uploadArea.style.borderColor = 'rgba(25, 135, 84, 0.5)';
                uploadArea.style.borderStyle = 'solid';
            }
        });

        // Remove new image functionality
        removeNewImageBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            bannerFileInput.value = '';
            imagePreview.src = '';
            imagePreview.classList.add('d-none');
            defaultPreview.classList.remove('d-none');
            removeNewImageBtn.classList.add('d-none');
            fileSizeInfo.textContent = '';
            fileError.textContent = '';
            uploadArea.style.borderColor = 'rgba(255,255,255,0.3)';
            uploadArea.style.borderStyle = 'dashed';

            // Show current banner again if it exists
            if (currentBannerImage && currentBannerImage.src) {
                currentBannerImage.style.display = 'block';
            }
            if (currentImageContainer) {
                currentImageContainer.style.display = 'block';
            }
            if (changeImageBtn) {
                changeImageBtn.style.display = 'inline-block';
            }
            if (removeCurrentImageBtn) {
                removeCurrentImageBtn.style.display = 'inline-block';
            }
        });

        // Change image button functionality
        if (changeImageBtn) {
            changeImageBtn.addEventListener('click', function() {
                uploadArea.classList.remove('d-none');
                if (currentImageContainer) {
                    currentImageContainer.style.display = 'none';
                }
                changeImageBtn.style.display = 'none';
                removeCurrentImageBtn.style.display = 'none';
                bannerFileInput.click();
            });
        }

        // Remove current image button functionality
        if (removeCurrentImageBtn) {
            removeCurrentImageBtn.addEventListener('click', function() {
                // Clear the current banner path
                currentBannerPath.value = '';

                // Hide current image
                if (currentBannerImage) {
                    currentBannerImage.style.display = 'none';
                }
                if (currentImageContainer) {
                    currentImageContainer.style.display = 'none';
                }

                // Show upload area
                uploadArea.classList.remove('d-none');

                // Hide the action buttons
                changeImageBtn.style.display = 'none';
                removeCurrentImageBtn.style.display = 'none';

                // Show success message
                const successDiv = document.createElement('div');
                successDiv.className = 'alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 text-white small py-2 rounded-pill mb-3';
                successDiv.innerHTML = '<i class="bi bi-check-circle me-2"></i>Current banner marked for removal. Upload a new one or leave empty.';

                const bannerSection = document.querySelector('.mb-4');
                bannerSection.insertBefore(successDiv, uploadArea);

                // Remove message after 5 seconds
                setTimeout(() => {
                    successDiv.remove();
                }, 5000);
            });
        }

        // Click on upload area triggers file input
        uploadArea.addEventListener('click', function(e) {
            if (e.target !== bannerFileInput && e.target !== removeNewImageBtn) {
                bannerFileInput.click();
            }
        });

        // Drag and drop functionality
        uploadArea.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.style.borderColor = 'rgba(138, 43, 226, 0.5)';
            uploadArea.style.background = 'rgba(138, 43, 226, 0.1)';
        });

        uploadArea.addEventListener('dragleave', function(e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.style.borderColor = 'rgba(255,255,255,0.3)';
            uploadArea.style.background = 'rgba(255,255,255,0.05)';
        });

        uploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();

            uploadArea.style.borderColor = 'rgba(255,255,255,0.3)';
            uploadArea.style.background = 'rgba(255,255,255,0.05)';

            const files = e.dataTransfer.files;
            if (files.length > 0) {
                bannerFileInput.files = files;
                bannerFileInput.dispatchEvent(new Event('change'));
            }
        });

        // Form submission validation
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            // Clear any previous file errors
            fileError.textContent = '';

            // Check if a new file is selected
            if (bannerFileInput.files.length > 0) {
                const file = bannerFileInput.files[0];
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                const maxSize = 5 * 1024 * 1024;

                if (!validTypes.includes(file.type)) {
                    e.preventDefault();
                    fileError.textContent = 'Please select a valid image file (JPG, PNG, GIF, WebP).';
                    bannerFileInput.focus();
                    return;
                }

                if (file.size > maxSize) {
                    e.preventDefault();
                    fileError.textContent = 'File size must be less than 5MB.';
                    bannerFileInput.focus();
                    return;
                }
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}