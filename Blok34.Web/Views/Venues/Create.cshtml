@using Blok34.Domain.Enums
@model Blok34.Domain.DomainModels.Venue
@{
    ViewData["Title"] = "Create Venue";
}

<div class="d-flex align-items-start justify-content-start"
     style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10 col-sm-12">
                <!-- Glassmorphism Card -->
                <div class="card border-0 shadow"
                     style="background: rgba(255,255,255,0.07);
                            backdrop-filter: blur(12px);
                            border-radius: 20px;
                            border: 1px solid rgba(255,255,255,0.15);
                            margin-bottom: 2rem;">

                    <div class="card-body p-4">

                        <!-- Logo and Title -->
                        <div class="text-center mb-4">
                            <svg width="60" height="40" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-2">
                                <defs>
                                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4B0082" />
                                        <stop offset="100%" stop-color="#6a0dad" />
                                    </linearGradient>
                                </defs>
                                <rect x="15" y="10" width="25" height="40" rx="4" fill="url(#grad1)" />
                                <rect x="40" y="20" width="20" height="30" rx="3" fill="#5D3FD3" />
                                <rect x="60" y="30" width="15" height="20" rx="2" fill="#4B0082" />
                            </svg>
                            <h3 class="text-white fw-bold mb-1">Register Your Venue</h3>
                            <p class="text-white-50">Add your venue to our platform</p>
                        </div>

                        <!-- Venue Form -->
                        <form asp-action="Create" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-4"
                                 role="alert">
                            </div>

                            <!-- Hidden Manager ID Field -->
                            <input type="hidden" asp-for="VenueManagerId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />

                            <!-- Venue Name -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Name" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-building me-2"></i>Venue Name
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-building position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Name"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Enter venue name"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Category Dropdown - Custom Styled -->
                            <div class="mb-3">
                                <label asp-for="Category" class="form-label text-white fw-medium mb-2">
                                    <i class="bi bi-tags me-2"></i>Venue Category
                                </label>
                                <div class="position-relative">
                                    <!-- Custom dropdown container -->
                                    <div class="custom-select-wrapper">
                                        <div class="custom-select-trigger d-flex align-items-center justify-content-between bg-transparent text-white py-2 px-3 rounded-pill"
                                             style="border: 1px solid rgba(255,255,255,0.3); cursor: pointer; transition: all 0.2s ease;"
                                             id="categoryTrigger">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-tag me-2 text-white-50"></i>
                                                <span id="selectedCategory">Select a category</span>
                                            </div>
                                            <i class="bi bi-chevron-down text-white-50" id="dropdownArrow"></i>
                                        </div>

                                        <!-- Custom dropdown menu -->
                                        <div class="custom-select-options shadow"
                                             style="background: rgba(30, 30, 46, 0.98);
                                                    backdrop-filter: blur(10px);
                                                    border: 1px solid rgba(255,255,255,0.15);
                                                    border-radius: 12px;
                                                    margin-top: 0.5rem;
                                                    padding: 0.5rem;
                                                    display: none;
                                                    position: absolute;
                                                    width: 100%;
                                                    z-index: 1000;"
                                             id="categoryOptions">
                                            @foreach (var category in Html.GetEnumSelectList<VenueCategory>())
                                            {
                                                <div class="custom-option d-flex align-items-center text-white py-2 px-3 rounded"
                                                     style="margin: 0.1rem 0; cursor: pointer; transition: all 0.2s ease;"
                                                     data-value="@category.Value">
                                                    <div class="me-2 d-flex align-items-center justify-content-center rounded"
                                                         style="width: 28px; height: 28px; background: rgba(255,255,255,0.1);">
                                                        <i class="bi bi-geo-alt" style="font-size: 0.8rem;"></i>
                                                    </div>
                                                    <span>@category.Text</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Hidden select for form submission -->
                                        <select asp-for="Category"
                                                asp-items="Html.GetEnumSelectList<VenueCategory>()"
                                                class="d-none"
                                                id="hiddenCategorySelect"
                                                aria-required="true">
                                            <option value="" selected disabled>Select a category</option>
                                        </select>
                                    </div>
                                </div>
                                <span asp-validation-for="Category" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Description -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Description" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-text-paragraph me-2"></i>Description
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-text-left position-absolute top-0 start-0 ms-3 mt-3 text-white-50"></i>
                                    <textarea asp-for="Description"
                                              class="form-control bg-transparent text-white py-2 rounded-4 ps-5"
                                              style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem; min-height: 100px;"
                                              placeholder="Describe your venue (facilities, atmosphere, etc.)"
                                              aria-required="false"></textarea>
                                </div>
                                <span asp-validation-for="Description" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Address -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Address" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-geo-alt me-2"></i>Address
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-geo-alt position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Address"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Full address of the venue"
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Phone" class="form-label text-white fw-medium mb-1">
                                    <i class="bi bi-telephone me-2"></i>Contact Phone
                                </label>
                                <div class="position-relative">
                                    <i class="bi bi-telephone position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                                    <input asp-for="Phone"
                                           class="form-control bg-transparent text-white py-2 rounded-pill ps-5"
                                           style="border-color: rgba(255,255,255,0.3); font-size: 0.9rem;"
                                           placeholder="Phone number for inquiries"
                                           aria-required="false" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger d-block mt-1"></span>
                            </div>

                            <!-- Banner Image Upload -->
                            <div class="mb-4">
                                <label class="form-label text-white fw-medium mb-2">
                                    <i class="bi bi-image me-2"></i>Venue Banner Image
                                </label>

                                <!-- Image Preview Container -->
                                <div class="image-preview-container mb-3 position-relative">
                                    <!-- Upload Area (only shows when no image selected) -->
                                    <div class="image-upload-area rounded" id="uploadArea"
                                         style="border: 2px dashed rgba(255,255,255,0.3);
                                                background: rgba(255,255,255,0.05);
                                                min-height: 200px;
                                                cursor: pointer;
                                                position: relative;">
                                        <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4">
                                            <i class="bi bi-cloud-arrow-up display-4 text-white-50 mb-3"></i>
                                            <p class="text-white-50 mb-2 text-center">Click or drag to upload banner image</p>
                                            <small class="text-white-50">Recommended: 1920x400 pixels</small>
                                        </div>

                                        <!-- Hidden File Input -->
                                        <input type="file"
                                               name="BannerFile"
                                               id="bannerFileInput"
                                               accept="image/*"
                                               class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" />
                                    </div>

                                    <!-- Preview Area (shows when image is selected) -->
                                    <div class="image-preview-area rounded d-none" id="previewArea"
                                         style="border: 2px solid rgba(255,255,255,0.3);
                                                background: rgba(0,0,0,0.3);
                                                min-height: 200px;
                                                position: relative;
                                                overflow: hidden;">

                                        <!-- Selected Image -->
                                        <img id="imagePreview"
                                             class="w-100 h-100 object-fit-cover"
                                             style="max-height: 300px; object-fit: cover;" />

                                        <!-- Image Info Overlay -->
                                        <div class="position-absolute top-0 start-0 w-100 p-3"
                                             style="background: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent);">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="text-white">
                                                    <i class="bi bi-image me-2"></i>
                                                    <small id="fileName">No file selected</small>
                                                </div>
                                                <div class="text-white" id="fileSizeDisplay"></div>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="position-absolute bottom-0 end-0 m-3 d-flex gap-2">
                                            <!-- Choose Another Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary rounded-pill"
                                                    id="chooseAnotherBtn"
                                                    style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); font-size: 0.85rem;">
                                                <i class="bi bi-arrow-repeat me-1"></i>Choose Another
                                            </button>

                                            <!-- Remove Image Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-pill"
                                                    id="removeImageBtn"
                                                    style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); font-size: 0.85rem;">
                                                <i class="bi bi-trash me-1"></i>Remove
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center justify-content-between">
                                    <small class="text-white-50">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Upload a banner image for your venue (JPG, PNG, GIF, WebP - Max 5MB)
                                    </small>
                                    <small class="text-white-50 d-none" id="fileInfo">No file selected</small>
                                </div>
                                <span class="text-danger d-block mt-1" id="fileError"></span>
                            </div>

                            <!-- Visibility Toggle Section -->
                            <div class="mb-4 p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                <div class="form-check form-switch d-flex align-items-start">
                                    <input class="form-check-input me-3"
                                           type="checkbox"
                                           role="switch"
                                           asp-for="IsPublic"
                                           id="isPublicCheckbox"
                                           style="width: 3rem; height: 1.5rem; background-color: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.3);"
                                           checked />
                                    <div>
                                        <label class="form-check-label text-white fw-medium">
                                            <i class="bi bi-eye me-2"></i>Public Venue
                                        </label>

                                        <!-- Public Option Info -->
                                        <div class="mt-2 mb-2 p-2 rounded" style="background: rgba(25, 135, 84, 0.1); border-left: 3px solid rgba(25, 135, 84, 0.5);">
                                            <p class="text-white small mb-0">
                                                <i class="bi bi-check-circle text-success me-1"></i>
                                                <strong>Public venues</strong> are immediately available for all users to create events.
                                            </p>
                                        </div>

                                        <!-- Private Option Info -->
                                        <div class="mt-2 p-2 rounded" style="background: rgba(13, 110, 253, 0.1); border-left: 3px solid rgba(13, 110, 253, 0.5); display: none;" id="privateInfo">
                                            <p class="text-white small mb-0">
                                                <i class="bi bi-shield-lock text-primary me-1"></i>
                                                <strong>Private venues</strong> require ownership verification.
                                                Only you can create events, and we'll contact you via email to confirm venue ownership.
                                                Other users cannot see or use your private venue.
                                            </p>
                                        </div>

                                        <p class="text-white-50 small mb-0 mt-2">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Toggle to switch between public and private venue settings.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit"
                                    class="btn w-100 py-2 mb-2 text-white fw-medium rounded-pill fw-bold"
                                    style="background: linear-gradient(135deg, #6a0dad, #8a2be2);
                                           border: none;
                                           font-size: 0.95rem;
                                           transition: all 0.2s ease;
                                           box-shadow: 0 4px 15px rgba(106,13,173,0.3);">
                                <i class="bi bi-plus-circle me-2"></i>Create Venue
                            </button>

                            <!-- Back Link -->
                            <div class="text-center mt-3">
                                <a asp-action="Index"
                                   class="text-decoration-none fw-medium"
                                   style="color: #7fa3e4">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Venues List
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Information Card -->
                <div class="card border-0 shadow mt-3"
                     style="background: rgba(255,255,255,0.05);
                            backdrop-filter: blur(12px);
                            border-radius: 16px;
                            border: 1px solid rgba(255,255,255,0.1);">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-info-circle text-info me-2" style="font-size: 1.2rem;"></i>
                            <h6 class="text-white mb-0">Venue Registration Tips</h6>
                        </div>
                        <ul class="text-white-50 small mb-0 ps-3">
                            <li>Choose the right category to help users find your venue</li>
                            <li>Public venues allow anyone to create events instantly</li>
                            <li>Private venues require ownership verification via email</li>
                            <li>Provide accurate contact information for customer inquiries</li>
                            <li>Add a descriptive banner image to attract more visitors</li>
                            <li>You can edit these details later from your dashboard</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Consistent with other pages styling */
    .form-control:focus,
    .form-control:focus-within {
        background-color: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
        color: white !important;
    }

    .form-control::placeholder {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.9rem;
    }

    textarea.form-control {
        resize: vertical;
    }

    /* Custom styling for icons inside inputs */
    .form-control.ps-5 {
        padding-left: 2.8rem !important;
    }

    /* Button hover effect */
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(106,13,173,0.4) !important;
    }

    .btn-outline-primary {
        border-color: rgba(138, 43, 226, 0.5);
        color: rgba(138, 43, 226, 0.8);
        background: rgba(138, 43, 226, 0.1);
    }

        .btn-outline-primary:hover {
            background-color: rgba(138, 43, 226, 0.2) !important;
            border-color: rgba(138, 43, 226, 0.8);
            color: rgba(138, 43, 226, 1);
        }

    .btn-outline-danger {
        border-color: rgba(220, 53, 69, 0.5);
        color: rgba(220, 53, 69, 0.8);
        background: rgba(220, 53, 69, 0.1);
    }

        .btn-outline-danger:hover {
            background-color: rgba(220, 53, 69, 0.2) !important;
            border-color: rgba(220, 53, 69, 0.8);
            color: rgba(220, 53, 69, 1);
        }

    /* List styling */
    ul {
        padding-left: 1.25rem;
    }

    li {
        margin-bottom: 0.25rem;
    }

    /* Custom Select Styling */
    .custom-select-wrapper {
        position: relative;
    }

    .custom-select-trigger:hover {
        background: rgba(255,255,255,0.05) !important;
        border-color: rgba(138, 43, 226, 0.3) !important;
    }

    .custom-select-trigger:focus {
        background: rgba(255,255,255,0.1) !important;
        border-color: rgba(138, 43, 226, 0.5) !important;
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.2) !important;
    }

    .custom-select-options {
        max-height: 250px;
        overflow-y: auto;
    }

    .custom-option:hover {
        background: rgba(138, 43, 226, 0.25) !important;
        transform: translateX(5px);
    }

        .custom-option:hover .me-2 {
            background: rgba(138, 43, 226, 0.4) !important;
            transform: scale(1.1);
        }

    /* Scrollbar styling */
    .custom-select-options::-webkit-scrollbar {
        width: 6px;
    }

    .custom-select-options::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.05);
        border-radius: 3px;
    }

    .custom-select-options::-webkit-scrollbar-thumb {
        background: rgba(138, 43, 226, 0.5);
        border-radius: 3px;
    }

        .custom-select-options::-webkit-scrollbar-thumb:hover {
            background: rgba(138, 43, 226, 0.7);
        }

    /* Image upload area styling */
    .image-upload-area:hover {
        border-color: rgba(138, 43, 226, 0.5) !important;
        background: rgba(138, 43, 226, 0.05) !important;
    }

    /* Object fit utility */
    .object-fit-cover {
        object-fit: cover;
    }

    /* Cursor pointer utility */
    .cursor-pointer {
        cursor: pointer;
    }

    .form-check-input:checked {
        background-color: #8a2be2 !important;
        border-color: #8a2be2 !important;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.2rem rgba(138, 43, 226, 0.25) !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Category dropdown functionality
        const categoryTrigger = document.getElementById('categoryTrigger');
        const categoryOptions = document.getElementById('categoryOptions');
        const dropdownArrow = document.getElementById('dropdownArrow');
        const selectedCategory = document.getElementById('selectedCategory');
        const hiddenSelect = document.getElementById('hiddenCategorySelect');
        const customOptions = document.querySelectorAll('.custom-option');

        // Toggle dropdown on trigger click
        if (categoryTrigger) {
            categoryTrigger.addEventListener('click', function(e) {
                e.stopPropagation();

                if (categoryOptions.style.display === 'block') {
                    categoryOptions.style.display = 'none';
                    dropdownArrow.classList.remove('bi-chevron-up');
                    dropdownArrow.classList.add('bi-chevron-down');
                } else {
                    categoryOptions.style.display = 'block';
                    dropdownArrow.classList.remove('bi-chevron-down');
                    dropdownArrow.classList.add('bi-chevron-up');
                }
            });
        }

        // Handle option selection
        customOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.stopPropagation();

                const value = this.getAttribute('data-value');
                const text = this.querySelector('span').textContent;

                selectedCategory.textContent = text;
                hiddenSelect.value = value;
                categoryOptions.style.display = 'none';
                dropdownArrow.classList.remove('bi-chevron-up');
                dropdownArrow.classList.add('bi-chevron-down');
                categoryTrigger.style.background = 'rgba(138, 43, 226, 0.1)';
                categoryTrigger.style.borderColor = 'rgba(138, 43, 226, 0.4)';
                hiddenSelect.dispatchEvent(new Event('change'));
            });
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function() {
            if (categoryOptions) {
                categoryOptions.style.display = 'none';
                dropdownArrow.classList.remove('bi-chevron-up');
                dropdownArrow.classList.add('bi-chevron-down');
            }
        });

        // Prevent dropdown from closing when clicking inside it
        if (categoryOptions) {
            categoryOptions.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        }

        // Banner Image Upload Functionality
        const bannerFileInput = document.getElementById('bannerFileInput');
        const uploadArea = document.getElementById('uploadArea');
        const previewArea = document.getElementById('previewArea');
        const imagePreview = document.getElementById('imagePreview');
        const chooseAnotherBtn = document.getElementById('chooseAnotherBtn');
        const removeImageBtn = document.getElementById('removeImageBtn');
        const fileNameDisplay = document.getElementById('fileName');
        const fileSizeDisplay = document.getElementById('fileSizeDisplay');
        const fileInfo = document.getElementById('fileInfo');
        const fileError = document.getElementById('fileError');

        // Handle file selection
        bannerFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            handleFileSelection(file);
        });

        // Handle file selection logic
        function handleFileSelection(file) {
            if (file) {
                // Validate file type
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    showError('Please select a valid image file (JPG, PNG, GIF, WebP).');
                    clearFileSelection();
                    return;
                }

                // Validate file size (5MB)
                const maxSize = 5 * 1024 * 1024;
                if (file.size > maxSize) {
                    showError('File size must be less than 5MB.');
                    clearFileSelection();
                    return;
                }

                // Clear any previous errors
                clearError();

                // Display file info
                const fileSize = file.size > 1024 * 1024
                    ? (file.size / (1024 * 1024)).toFixed(2) + ' MB'
                    : (file.size / 1024).toFixed(2) + ' KB';

                fileNameDisplay.textContent = file.name.length > 20
                    ? file.name.substring(0, 20) + '...'
                    : file.name;
                fileSizeDisplay.textContent = fileSize;
                fileInfo.textContent = `${file.name} (${fileSize})`;
                fileInfo.classList.remove('d-none');

                // Preview image
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;

                    // Switch to preview mode
                    uploadArea.classList.add('d-none');
                    previewArea.classList.remove('d-none');

                    // Add success styling
                    previewArea.style.borderColor = 'rgba(25, 135, 84, 0.5)';
                    previewArea.style.borderStyle = 'solid';
                }
                reader.readAsDataURL(file);
            }
        }

        // Choose another image button
        chooseAnotherBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            bannerFileInput.click();
        });

        // Remove selected image
        removeImageBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            clearFileSelection();
        });

        // Clear file selection
        function clearFileSelection() {
            bannerFileInput.value = '';
            uploadArea.classList.remove('d-none');
            previewArea.classList.add('d-none');
            fileInfo.textContent = 'No file selected';
            fileInfo.classList.add('d-none');
            clearError();

            // Reset styling
            previewArea.style.borderColor = 'rgba(255,255,255,0.3)';
            previewArea.style.borderStyle = 'solid';
        }

        // Show error message
        function showError(message) {
            fileError.textContent = message;
            fileError.classList.remove('d-none');
        }

        // Clear error message
        function clearError() {
            fileError.textContent = '';
            fileError.classList.add('d-none');
        }

        // Click on upload area triggers file input
        uploadArea.addEventListener('click', function(e) {
            if (e.target !== bannerFileInput) {
                bannerFileInput.click();
            }
        });

        // Drag and drop functionality
        uploadArea.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.style.borderColor = 'rgba(138, 43, 226, 0.5)';
            uploadArea.style.background = 'rgba(138, 43, 226, 0.1)';
            uploadArea.style.borderStyle = 'dashed';
        });

        uploadArea.addEventListener('dragleave', function(e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.style.borderColor = 'rgba(255,255,255,0.3)';
            uploadArea.style.background = 'rgba(255,255,255,0.05)';
            uploadArea.style.borderStyle = 'dashed';
        });

        uploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();

            uploadArea.style.borderColor = 'rgba(255,255,255,0.3)';
            uploadArea.style.background = 'rgba(255,255,255,0.05)';
            uploadArea.style.borderStyle = 'dashed';

            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleFileSelection(files[0]);
            }
        });

        // Visibility toggle functionality
        const isPublicCheckbox = document.getElementById('isPublicCheckbox');
        const privateInfo = document.getElementById('privateInfo');
        const publicInfo = document.querySelector('[style*="rgba(25, 135, 84, 0.1)"]');
        const switchLabel = document.querySelector('.form-check-label');

        function updateVisibilityInfo() {
            if (isPublicCheckbox.checked) {
                publicInfo.style.display = 'block';
                privateInfo.style.display = 'none';
                switchLabel.innerHTML = '<i class="bi bi-eye me-2"></i>Public Venue';
            } else {
                publicInfo.style.display = 'none';
                privateInfo.style.display = 'block';
                switchLabel.innerHTML = '<i class="bi bi-shield-lock me-2"></i>Private Venue';
            }
        }

        // Initialize visibility info
        updateVisibilityInfo();

        // Update on change
        isPublicCheckbox.addEventListener('change', updateVisibilityInfo);

        // Form submission validation
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            // Clear any previous file errors
            fileError.textContent = '';

            // Check if a file is selected (optional field)
            if (bannerFileInput.files.length > 0) {
                const file = bannerFileInput.files[0];
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                const maxSize = 5 * 1024 * 1024;

                if (!validTypes.includes(file.type)) {
                    e.preventDefault();
                    fileError.textContent = 'Please select a valid image file (JPG, PNG, GIF, WebP).';
                    bannerFileInput.focus();
                    return;
                }

                if (file.size > maxSize) {
                    e.preventDefault();
                    fileError.textContent = 'File size must be less than 5MB.';
                    bannerFileInput.focus();
                    return;
                }
            }

            // Validate category is selected
            if (!hiddenSelect.value) {
                e.preventDefault();
                const categoryError = document.createElement('div');
                categoryError.className = 'alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-white small py-2 rounded-pill mb-3';
                categoryError.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Please select a venue category.';

                const categorySection = document.querySelector('.mb-3');
                categorySection.insertBefore(categoryError, categorySection.firstChild);

                // Scroll to error
                categoryError.scrollIntoView({ behavior: 'smooth', block: 'center' });

                // Remove error after 5 seconds
                setTimeout(() => {
                    categoryError.remove();
                }, 5000);

                return;
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}