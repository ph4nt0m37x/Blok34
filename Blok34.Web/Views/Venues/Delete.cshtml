@model Blok34.Domain.DomainModels.Venue
@Html.AntiForgeryToken()
@using Blok34.Domain.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Delete Venue";
    var hasBanner = !string.IsNullOrEmpty(Model.BannerPath);
    var bannerUrl = hasBanner ? Model.BannerPath : "/images/default-venue-banner.jpg";

    var currentUserId = UserManager.GetUserId(User);
    var isCreator = Model.VenueManagerId == currentUserId;

    // Check if venue has events
    bool hasUpcomingEvents = Model.Events?.Any(e => e.StartDate > DateTime.UtcNow) ?? false;
    bool hasOngoingEvents = Model.Events?.Any(e => e.StartDate <= DateTime.UtcNow &&
                                                   (!e.EndDate.HasValue || e.EndDate.Value > DateTime.UtcNow)) ?? false;
    bool hasPastEvents = Model.Events?.Any(e => e.EndDate.HasValue && e.EndDate.Value <= DateTime.UtcNow) ?? false;

    int totalEvents = Model.Events?.Count ?? 0;
    int upcomingEventsCount = Model.Events?.Count(e => e.StartDate > DateTime.UtcNow) ?? 0;
    int ongoingEventsCount = Model.Events?.Count(e => e.StartDate <= DateTime.UtcNow &&
                                                     (!e.EndDate.HasValue || e.EndDate.Value > DateTime.UtcNow)) ?? 0;
}

<div class="d-flex align-items-start justify-content-start" style="min-height: 100vh; padding-top: 1rem; padding-bottom: 3rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12">
                <!-- Venue Banner with Warning Overlay -->
                @if (hasBanner)
                {
                    <div class="card border-0 shadow mb-4" style="border-radius: 20px; overflow: hidden; border: 1px solid rgba(220,53,69,0.3);">
                        <div class="position-relative" style="height: 300px;">
                            <img src="@bannerUrl" class="card-img-top" alt="@Model.Name Banner" style="height: 100%; width: 100%; object-fit: cover; opacity: 0.7;">
                            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(220,53,69,0.4), rgba(108,117,125,0.8));"></div>
                            <div class="position-absolute bottom-0 start-0 p-4">
                                <span class="badge rounded-pill px-3 py-2 mb-2" style="background: rgba(220,53,69,0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.2);">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Deleting Venue
                                </span>
                                <h1 class="text-white fw-bold mb-0" style="text-shadow: 0 2px 10px rgba(0,0,0,0.7);">@Model.Name</h1>
                                <div class="text-white-50 mt-2">
                                    <i class="bi bi-geo-alt me-1"></i>@Model.Address
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow mb-4" style="background: linear-gradient(135deg, #dc3545, #6c757d); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15);">
                        <div class="card-body p-5 text-center">
                            <svg width="80" height="60" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-3">
                                <defs>
                                    <linearGradient id="gradVenueDelete" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#ffffff" />
                                        <stop offset="100%" stop-color="#f8d7da" />
                                    </linearGradient>
                                </defs>
                                <path d="M30,15 L70,15 L75,25 L25,25 Z" fill="url(#gradVenueDelete)" opacity="0.9" />
                                <rect x="25" y="25" width="50" height="25" rx="3" fill="url(#gradVenueDelete)" />
                                <rect x="35" y="35" width="10" height="10" rx="2" fill="#ffffff" />
                                <rect x="55" y="35" width="10" height="10" rx="2" fill="#ffffff" />
                                <path d="M85,15 L95,25 M95,15 L85,25" stroke="#dc3545" stroke-width="3" stroke-linecap="round" />
                            </svg>
                            <h1 class="text-white fw-bold mb-2">@Model.Name</h1>
                            <div class="text-white-50 mb-3">
                                <i class="bi bi-geo-alt me-1"></i>@Model.Address
                            </div>
                            <span class="badge rounded-pill px-3 py-2" style="background: rgba(220,53,69,0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3);">
                                <i class="bi bi-exclamation-triangle me-1"></i>Delete Venue
                            </span>
                        </div>
                    </div>
                }

                <!-- Critical Warning Card -->
                @if (hasUpcomingEvents || hasOngoingEvents)
                {
                    <div class="card border-0 shadow mb-4" style="background: rgba(220,53,69,0.15); backdrop-filter: blur(12px); border-radius: 20px; border: 2px solid rgba(220,53,69,0.4);">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start">
                                <div class="me-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: rgba(220,53,69,0.3); border: 2px solid rgba(220,53,69,0.5);">
                                        <i class="bi bi-exclamation-triangle text-white" style="font-size: 2rem;"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h4 class="text-white fw-bold mb-2"><i class="bi bi-calendar-x me-2"></i>Critical: Active Events Found</h4>
                                    <p class="text-white mb-2">This venue has @(hasOngoingEvents ? "ongoing" : "upcoming") events that will be affected:</p>
                                    <ul class="text-white-50 mb-0">
                                        @if (hasOngoingEvents)
                                        {
                                            <li><i class="bi bi-play-circle me-1"></i>@ongoingEventsCount ongoing event(s) will be immediately affected</li>
                                        }
                                        @if (hasUpcomingEvents)
                                        {
                                            <li><i class="bi bi-calendar-event me-1"></i>@upcomingEventsCount upcoming event(s) will be cancelled</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Standard Warning Card -->
                <div class="card border-0 shadow mb-4" style="background: rgba(220,53,69,0.1); backdrop-filter: blur(12px); border-radius: 20px; border: 1px solid rgba(220,53,69,0.3);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: rgba(220,53,69,0.2); border: 2px solid rgba(220,53,69,0.4);">
                                    <i class="bi bi-exclamation-octagon text-danger" style="font-size: 1.8rem;"></i>
                                </div>
                            </div>
                            <div>
                                <h4 class="text-white fw-bold mb-1"><i class="bi bi-shield-exclamation me-2"></i>Warning: Permanent Action</h4>
                                <p class="text-white-50 mb-0">Deleting this venue will permanently remove all associated data. This action cannot be undone.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Card -->
                <div class="card border-0 shadow" style="background: rgba(255,255,255,0.07); backdrop-filter: blur(12px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.15); margin-bottom: 2rem;">
                    <div class="card-body p-4 p-md-5">
                        <div class="row">
                            <!-- Left Column - Venue Details -->
                            <div class="col-lg-8">
                                <!-- Venue Information -->
                                <div class="mb-5">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Venue Information</h4>
                                    <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                        <div class="row mb-3">
                                            <div class="col-md-6 mb-3">
                                                <div class="text-white-50 small">Venue Name</div>
                                                <div class="text-white fw-medium">@Model.Name</div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <div class="text-white-50 small">Venue Type</div>
                                                <div class="text-white">
                                                    <span class="badge @(Model.IsPublic ? "bg-info" : "bg-secondary")">
                                                        <i class="bi @(Model.IsPublic ? "bi-building" : "bi-house-door") me-1"></i>
                                                        @(Model.IsPublic ? "Public" : "Private")
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <div class="text-white-50 small">Phone Number</div>
                                                <div class="text-white fw-medium">
                                                    <i class="bi bi-telephone me-1"></i>
                                                    @(string.IsNullOrEmpty(Model.Phone) ? "Not provided" : Model.Phone)
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <div class="text-white-50 small">Address</div>
                                                <div class="text-white">
                                                    <i class="bi bi-geo-alt me-1"></i>
                                                    @Model.Address
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Venue Description -->
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <div class="mb-5">
                                        <h4 class="text-white fw-bold mb-3"><i class="bi bi-text-paragraph me-2"></i>Description</h4>
                                        <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <p class="text-white mb-0" style="line-height: 1.8; white-space: pre-line;">@Model.Description</p>
                                        </div>
                                    </div>
                                }

                                <!-- Banner Information -->
                                @if (hasBanner)
                                {
                                    <div class="mb-5">
                                        <h4 class="text-white fw-bold mb-3"><i class="bi bi-image me-2"></i>Banner Image</h4>
                                        <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <div class="rounded" style="overflow: hidden; border: 2px solid rgba(255,255,255,0.1);">
                                                        <img src="@bannerUrl" alt="Venue Banner" style="width: 100%; height: 150px; object-fit: cover;">
                                                    </div>
                                                </div>
                                                <div class="col-md-8">
                                                    <div class="text-white-50 small">Banner Path</div>
                                                    <div class="text-white-50 small">This banner will be removed from storage</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Right Column - Impact Analysis -->
                            <div class="col-lg-4">
                                <!-- Events Impact -->
                                <div class="mb-4">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-calendar-event me-2"></i>Events Impact</h4>
                                    <div class="p-4 rounded" style="background: rgba(220,53,69,0.1); border: 1px solid rgba(220,53,69,0.3);">
                                        <div class="text-center mb-3">
                                            <div class="text-white fw-bold display-6">@totalEvents</div>
                                            <div class="text-white-50 small">Total Events</div>
                                        </div>

                                        @if (totalEvents > 0)
                                        {
                                            <div class="mt-3">
                                                <div class="text-white-50 small mb-2">
                                                    <i class="bi bi-exclamation-diamond me-1"></i>Deletion will affect:
                                                </div>
                                                <div class="row text-center">
                                                    @if (ongoingEventsCount > 0)
                                                    {
                                                        <div class="col-6 mb-2">
                                                            <div class="text-white fw-bold h5">@ongoingEventsCount</div>
                                                            <div class="text-white-50 small">Ongoing</div>
                                                        </div>
                                                    }
                                                    @if (upcomingEventsCount > 0)
                                                    {
                                                        <div class="col-6 mb-2">
                                                            <div class="text-white fw-bold h5">@upcomingEventsCount</div>
                                                            <div class="text-white-50 small">Upcoming</div>
                                                        </div>
                                                    }
                                                    @if (hasPastEvents)
                                                    {
                                                        <div class="col-6 mb-2">
                                                            <div class="text-white fw-bold h5">@(Model.Events?.Count(e => e.EndDate.HasValue && e.EndDate.Value <= DateTime.UtcNow) ?? 0)</div>
                                                            <div class="text-white-50 small">Past</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center mt-2">
                                                <div class="text-white-50 small">
                                                    <i class="bi bi-check-circle me-1"></i>No events associated with this venue
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Deletion Consequences -->
                                <div class="mb-4">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-trash me-2"></i>Deletion Consequences</h4>
                                    <div class="p-4 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                        <div class="text-white-50 small">
                                            <i class="bi bi-exclamation-diamond me-1"></i>This action will remove:
                                        </div>
                                        <ul class="text-white-50 small mt-2" style="list-style: none; padding-left: 0;">
                                            <li class="mb-1"><i class="bi bi-dot me-1"></i>Venue profile & details</li>
                                            <li class="mb-1"><i class="bi bi-dot me-1"></i>Associated banner image</li>
                                            @if (totalEvents > 0)
                                            {
                                                <li class="mb-1"><i class="bi bi-dot me-1"></i>@totalEvents event(s) and their data</li>
                                                <li><i class="bi bi-dot me-1"></i>All event attendees</li>
                                            }
                                            else
                                            {
                                                <li><i class="bi bi-dot me-1"></i>Venue references</li>
                                            }
                                        </ul>
                                    </div>
                                </div>

                                <!-- Venue Statistics -->
                                <div class="mb-4">
                                    <h4 class="text-white fw-bold mb-3"><i class="bi bi-bar-chart me-2"></i>Venue Statistics</h4>
                                    <div class="p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                                        <div class="row text-center">
                                            <div class="col-6 mb-2">
                                                <div class="text-white fw-bold h5">@totalEvents</div>
                                                <div class="text-white-50 small">Total Events</div>
                                            </div>
                                            <div class="col-6 mb-2">
                                                <div class="text-white fw-bold h5">
                                                    @(Model.IsPublic ? "Public" : "Private")
                                                </div>
                                                <div class="text-white-50 small">Type</div>
                                            </div>
                                            <div class="col-12 mt-2">
                                                <div class="text-white-50 small">
                                                    <i class="bi bi-calendar2-check me-1"></i>
                                                    @(hasUpcomingEvents? upcomingEventsCount + " upcoming" : "No upcoming")
                                                    events
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Form -->
                        <div class="mt-5 pt-4" style="border-top: 1px solid rgba(220,53,69,0.3);">
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <div class="p-4 rounded text-center" style="background: rgba(220,53,69,0.05); border: 1px solid rgba(220,53,69,0.2);">
                                        <div class="mb-4">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; background: linear-gradient(135deg, #dc3545, #6c757d);">
                                                <i class="bi bi-building-x text-white" style="font-size: 2rem;"></i>
                                            </div>
                                            <h4 class="text-white fw-bold mb-2">Confirm Venue Deletion</h4>
                                            <p class="text-white-50 mb-4">
                                                @if (hasUpcomingEvents || hasOngoingEvents)
                                                {
                                                    <text>This venue has <strong>@(hasOngoingEvents? ongoingEventsCount : upcomingEventsCount) active event(s)</strong>. Deleting will cancel all associated events.</text>
                                                }
                                                else
                                                {
                                                    <text>Please confirm that you want to permanently delete this venue.</text>
                                                }
                                            </p>
                                        </div>

                                        <form asp-action="Delete" method="post" id="deleteForm">
                                            <input type="hidden" asp-for="Id" />
                                            <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()" />

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <button type="submit" class="btn w-100 py-3 text-white fw-bold rounded-pill"
                                                            style="background: linear-gradient(135deg, #dc3545, #c82333); border: none; transition: all 0.2s ease;"
                                                            onclick="return confirmDelete()">
                                                        <i class="bi bi-trash3 me-2"></i>Delete Venue
                                                    </button>
                                                </div>
                                                <div class="col-md-6">
                                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn w-100 py-3 text-white fw-bold rounded-pill"
                                                       style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); transition: all 0.2s ease;">
                                                        <i class="bi bi-x-circle me-2"></i>Cancel
                                                    </a>
                                                </div>
                                            </div>

                                            <div class="form-check mt-4">
                                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                                <label class="form-check-label text-white-50 small" for="confirmDelete">
                                                    I understand this will delete the venue@(totalEvents > 0 ? " and all associated events" : "") permanently
                                                </label>
                                            </div>

                                            @if (hasUpcomingEvents || hasOngoingEvents)
                                            {
                                                <div class="form-check mt-2">
                                                    <input class="form-check-input" type="checkbox" id="confirmEvents" required>
                                                    <label class="form-check-label text-white-50 small" for="confirmEvents">
                                                        I understand that @(hasOngoingEvents? ongoingEventsCount : upcomingEventsCount) event(s) will be cancelled
                                                    </label>
                                                </div>
                                            }
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge {
        font-weight: 500;
        backdrop-filter: blur(10px);
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.4) !important;
    }

    .btn:first-child:hover {
        box-shadow: 0 6px 20px rgba(220,53,69,0.4) !important;
    }

    .rounded-circle {
        transition: transform 0.3s ease;
    }

        .rounded-circle:hover {
            transform: scale(1.05);
        }

    h1, h2, h3, h4, h5, h6 {
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.4) !important;
        }

    .bg-info {
        background: rgba(23,162,184,0.2) !important;
        border-color: rgba(23,162,184,0.3) !important;
        color: #a8e6ff !important;
    }

    .bg-secondary {
        background: rgba(108,117,125,0.2) !important;
        border-color: rgba(108,117,125,0.3) !important;
        color: #e2e6ea !important;
    }

    .form-check-input {
        background-color: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.3);
    }

        .form-check-input:checked {
            background-color: #dc3545;
            border-color: #dc3545;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(220,53,69,0.25);
        }

    .display-6 {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .h5 {
        font-size: 1.5rem;
        font-weight: 700;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form validation
            const deleteForm = document.getElementById('deleteForm');
            const confirmCheckbox = document.getElementById('confirmDelete');
            const confirmEventsCheckbox = document.getElementById('confirmEvents');
            const deleteButton = deleteForm.querySelector('button[type="submit"]');

            if (deleteForm && confirmCheckbox) {
                // Disable submit button initially
                deleteButton.disabled = true;
                deleteButton.style.opacity = '0.6';
                deleteButton.style.cursor = 'not-allowed';

                // Function to update button state
                function updateButtonState() {
                    const isConfirmed = confirmCheckbox.checked;
                    const isEventsConfirmed = !confirmEventsCheckbox || confirmEventsCheckbox.checked;

                    deleteButton.disabled = !isConfirmed || !isEventsConfirmed;
                    deleteButton.style.opacity = (isConfirmed && isEventsConfirmed) ? '1' : '0.6';
                    deleteButton.style.cursor = (isConfirmed && isEventsConfirmed) ? 'pointer' : 'not-allowed';
                }

                // Add event listeners
                confirmCheckbox.addEventListener('change', updateButtonState);
                if (confirmEventsCheckbox) {
                    confirmEventsCheckbox.addEventListener('change', updateButtonState);
                }
            }

            // Add pulse animation to critical warning card
            const criticalWarningCard = document.querySelector('.card[style*="rgba(220,53,69,0.15)"]');
            if (criticalWarningCard) {
                criticalWarningCard.style.animation = 'pulseCritical 1.5s infinite';
            }
        });

        function confirmDelete() {
            const checkboxes = [
                document.getElementById('confirmDelete'),
                document.getElementById('confirmEvents')
            ].filter(cb => cb); // Filter out null checkboxes

            for (const checkbox of checkboxes) {
                if (!checkbox.checked) {
                    const label = checkbox.nextElementSibling?.textContent?.trim();
                    alert(`Please confirm: ${label}`);
                    checkbox.focus();
                    return false;
                }
            }

            // Build warning message based on events
            const hasEvents = @totalEvents > 0;
            const upcomingCount = @upcomingEventsCount;
            const ongoingCount = @ongoingEventsCount;

            let eventWarning = '';
            if (ongoingCount > 0) {
                eventWarning = `\n\n⚠️ This venue has ${ongoingCount} ONGOING event(s) that will be immediately cancelled!`;
            } else if (upcomingCount > 0) {
                eventWarning = `\n\n⚠️ This venue has ${upcomingCount} upcoming event(s) that will be cancelled!`;
            }

            const message = `⚠️ FINAL WARNING ⚠️\n\nAre you absolutely sure you want to delete this venue?${eventWarning}\n\nThis will permanently delete:\n• The venue and all its details\n• Banner image files\n• ${@totalEvents} associated event(s)\n• All event attendees and data\n\nThis action cannot be undone!`;

            return confirm(message);
        }

        // Add CSS animation for critical pulse
        const style = document.createElement('style');
        style.textContent = `
        `;
        document.head.appendChild(style);
    </script>
}